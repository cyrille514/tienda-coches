---
// src/pages/factura/[id].astro
import pool from '../../lib/db';
import Stripe from 'stripe';

const { id } = Astro.params;

let factura: any = null;
let montoTotal = null;
let moneda = 'EUR';

if (id) {
  try {
    const query = 'SELECT * FROM facturas WHERE pk_factura = $1';
    const { rows } = await pool.query(query, [id]);
    factura = rows[0];

    if (factura && factura.stripe_payment_intent_id) {
      const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY || process.env.STRIPE_SECRET_KEY || '');
      const paymentIntent = await stripe.paymentIntents.retrieve(factura.stripe_payment_intent_id);
      
      montoTotal = paymentIntent.amount_received / 100;
      moneda = paymentIntent.currency.toUpperCase();
    }
  } catch (err) {
    console.error("Error al obtener la factura o datos de Stripe:", err);
  }
}

if (!factura) {
  return Astro.redirect('/404');
}
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Factura #{factura.pk_factura} - Tienda Coches</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen py-12 px-4">
  
  <main class="max-w-2xl mx-auto bg-white p-10 rounded-2xl shadow-xl border border-slate-200/80">
    
    <!-- En-tête de la facture -->
    <div class="flex justify-between items-start border-b border-slate-100 pb-8 mb-8">
      <div>
        <h1 class="text-3xl font-black tracking-tight text-blue-600">TIENDA COCHES</h1>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mt-1">Showroom Automóvil</p>
      </div>
      <div class="text-right">
        <span class="inline-block bg-blue-50 text-blue-700 text-sm font-bold px-3 py-1 rounded-full mb-1">
          Factura #{factura.pk_factura}
        </span>
        <p class="text-xs text-slate-500">Fecha: {new Date(factura.fecha_compra).toLocaleDateString('es-ES')}</p>
      </div>
    </div>

    <!-- Informations principales avec un style épuré -->
    <div class="space-y-3 mb-8 text-sm">
      <div class="flex justify-between items-center bg-slate-50/80 p-4 rounded-xl border border-slate-100">
        <span class="font-medium text-slate-600">ID de Cliente:</span>
        <span class="text-slate-800 font-mono text-xs bg-white px-2.5 py-1 rounded-md border border-slate-200">{factura.fk_cliente}</span>
      </div>
      <div class="flex justify-between items-center bg-slate-50/80 p-4 rounded-xl border border-slate-100">
        <span class="font-medium text-slate-600">ID Pago Stripe:</span>
        <span class="text-slate-800 font-mono text-xs bg-white px-2.5 py-1 rounded-md border border-slate-200">{factura.stripe_payment_intent_id}</span>
      </div>
      <div class="flex justify-between items-center bg-slate-50/80 p-4 rounded-xl border border-slate-100">
        <span class="font-medium text-slate-600">IVA Aplicado:</span>
        <span class="text-slate-900 font-bold">{factura.iva} %</span>
      </div>
      
      <!-- Total du véhicule mis en valeur -->
      {montoTotal !== null && (
        <div class="flex justify-between items-center bg-gradient-to-r from-blue-600 to-blue-700 text-white p-5 rounded-xl shadow-md mt-6">
          <div>
            <span class="block text-xs uppercase tracking-wider text-blue-100 font-semibold">Total del Vehículo</span>
            <span class="text-2xl font-black">{montoTotal.toFixed(2)} {moneda === 'EUR' ? '€' : moneda}</span>
          </div>
          <div class="bg-blue-500/30 p-2.5 rounded-lg text-blue-100 text-sm font-medium">
            Pagado ✓
          </div>
        </div>
      )}
    </div>

    <!-- Pied de page / Informations légales indicatives -->
    <div class="text-xs text-slate-400 border-t border-slate-100 pt-6 mb-8 text-center">
      <p>Gracias por confiar en Tienda Coches. Este documento es un comprobante oficial de compra generado de forma electrónica.</p>
    </div>

    <!-- Boutons d'action (masqués à l'impression) -->
    <div class="flex justify-end gap-3 border-t border-slate-100 pt-6 print:hidden">
      <a href="/" class="bg-slate-100 text-slate-700 px-5 py-2.5 rounded-xl font-semibold text-sm hover:bg-slate-200 transition">
        Volver a la tienda
      </a>
      <button 
        onclick="window.print()" 
        class="bg-blue-600 text-white px-6 py-2.5 rounded-xl font-semibold text-sm hover:bg-blue-700 transition shadow-lg shadow-blue-600/20 flex items-center gap-2">
        🖨️ Imprimir Factura / Guardar PDF
      </button>
    </div>
  </main>

</body>
</html>
