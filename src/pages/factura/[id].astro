---
// src/pages/factura/[id].astro
import pool from '../../lib/db';

const { id } = Astro.params;

let factura: any = null;

if (id) {
  try {
    const query = 'SELECT * FROM facturas WHERE pk_factura = $1';
    const { rows } = await pool.query(query, [id]);
    factura = rows[0];
  } catch (err) {
    console.error("Error al obtener la factura:", err);
  }
}

if (!factura) {
  return Astro.redirect('/404');
}
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Factura #{factura.pk_factura} - Tienda Coches</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen py-10 px-4">
  
  <main class="max-w-2xl mx-auto bg-white p-8 rounded-xl shadow-lg border border-gray-200">
    <!-- En-tête -->
    <div class="flex justify-between items-start border-b pb-6 mb-6">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900">TIENDA COCHES</h1>
        <p class="text-sm text-gray-500">Comprobante Oficial de Compra</p>
      </div>
      <div class="text-right">
        <p class="text-lg font-bold text-blue-600">Factura #{factura.pk_factura}</p>
        <p class="text-sm text-gray-500">Fecha: {new Date(factura.fecha_compra).toLocaleDateString('es-ES')}</p>
      </div>
    </div>

    <!-- Informations principales -->
    <div class="space-y-4 mb-8">
      <div class="flex justify-between bg-gray-50 p-4 rounded-lg">
        <span class="font-medium text-gray-700">ID de Cliente:</span>
        <span class="text-gray-600 font-mono text-sm">{factura.fk_cliente}</span>
      </div>
      <div class="flex justify-between bg-gray-50 p-4 rounded-lg">
        <span class="font-medium text-gray-700">ID Pago Stripe:</span>
        <span class="text-gray-600 font-mono text-sm">{factura.stripe_payment_intent_id}</span>
      </div>
      <div class="flex justify-between bg-gray-50 p-4 rounded-lg">
        <span class="font-medium text-gray-700">IVA Aplicado:</span>
        <span class="text-gray-900 font-bold">{factura.iva} %</span>
      </div>
    </div>

    <!-- Zone de boutons (Masquée à l'impression grâce à print:hidden) -->
    <div class="flex justify-end gap-4 border-t pt-6 print:hidden">
      <a href="/" class="bg-gray-200 text-gray-800 px-5 py-2.5 rounded-lg font-medium hover:bg-gray-300 transition">
        Volver a la tienda
      </a>
      <button 
        onclick="window.print()" 
        class="bg-blue-600 text-white px-6 py-2.5 rounded-lg font-medium hover:bg-blue-700 transition shadow-md flex items-center gap-2">
        🖨️ Imprimir Factura / Guardar PDF
      </button>
    </div>
  </main>

</body>
</html>
