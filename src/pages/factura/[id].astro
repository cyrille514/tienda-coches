---
// src/pages/factura/[id].astro
import pool from '../../lib/db';
import Stripe from 'stripe';

const { id } = Astro.params;

let factura: any = null;
let montoTotal = null;
let moneda = 'EUR';

if (id) {
  try {
    const query = 'SELECT * FROM facturas WHERE pk_factura = $1';
    const { rows } = await pool.query(query, [id]);
    factura = rows[0];

    if (factura && factura.stripe_payment_intent_id) {
      const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY || process.env.STRIPE_SECRET_KEY || '');
      const paymentIntent = await stripe.paymentIntents.retrieve(factura.stripe_payment_intent_id);
      
      montoTotal = paymentIntent.amount_received / 100;
      moneda = paymentIntent.currency.toUpperCase();
    }
  } catch (err) {
    console.error("Error al obtener la factura o datos de Stripe:", err);
  }
}

if (!factura) {
  return Astro.redirect('/404');
}
---

<html lang="es" class="bg-zinc-950 text-zinc-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Factura #{factura.pk_factura} - Tienda Coches</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Style spécifique pour forcer les dimensions des icônes et un rendu PDF propre -->
  <style>
    svg {
      width: 1rem !important;
      height: 1rem !important;
      min-width: 1rem !important;
      min-height: 1rem !important;
    }
    @media print {
      body {
        background-color: white !important;
        color: black !important;
      }
      .print-card {
        border: none !important;
        box-shadow: none !important;
        background-color: white !important;
        color: black !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="min-h-screen py-10 px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center font-sans">
  
  <main class="max-w-2xl w-full bg-zinc-900 border border-zinc-800 p-8 sm:p-10 rounded-2xl shadow-2xl print-card">
    
    <!-- En-tête de la facture -->
    <div class="flex justify-between items-start border-b border-zinc-800 pb-8 mb-8">
      <div>
        <div class="flex items-center gap-2.5 mb-1">
          <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-950 flex items-center justify-center font-bold text-sm tracking-tighter shrink-0">
            TC
          </div>
          <h1 class="text-2xl font-extrabold tracking-tight text-zinc-100">TIENDA COCHES</h1>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mt-1">Showroom Automóvil</p>
      </div>
      <div class="text-right">
        <span class="inline-block bg-emerald-500/10 text-emerald-400 text-xs font-bold px-3 py-1 rounded-full border border-emerald-500/20 mb-1">
          Factura #{factura.pk_factura}
        </span>
        <p class="text-xs text-zinc-400">Fecha: {new Date(factura.fecha_compra).toLocaleDateString('es-ES')}</p>
      </div>
    </div>

    <!-- Informations principales -->
    <div class="space-y-3 mb-8 text-sm">
      <div class="flex justify-between items-center bg-zinc-950/60 p-4 rounded-xl border border-zinc-800/80">
        <span class="font-medium text-zinc-400">ID de Cliente:</span>
        <span class="text-zinc-200 font-mono text-xs bg-zinc-900 px-2.5 py-1 rounded-md border border-zinc-800">{factura.fk_cliente}</span>
      </div>
      <div class="flex justify-between items-center bg-zinc-950/60 p-4 rounded-xl border border-zinc-800/80">
        <span class="font-medium text-zinc-400">ID Pago Stripe:</span>
        <span class="text-zinc-200 font-mono text-xs bg-zinc-900 px-2.5 py-1 rounded-md border border-zinc-800">{factura.stripe_payment_intent_id}</span>
      </div>
      <div class="flex justify-between items-center bg-zinc-950/60 p-4 rounded-xl border border-zinc-800/80">
        <span class="font-medium text-zinc-400">IVA Aplicado:</span>
        <span class="text-zinc-100 font-bold">{factura.iva} %</span>
      </div>
      
      <!-- Total du véhicule -->
      {montoTotal !== null && (
        <div class="flex justify-between items-center bg-zinc-100 text-zinc-950 p-5 rounded-xl shadow-lg mt-6">
          <div>
            <span class="block text-xs uppercase tracking-wider text-zinc-500 font-semibold">Total del Vehículo</span>
            <span class="text-2xl font-black">{montoTotal.toFixed(2)} {moneda === 'EUR' ? '€' : moneda}</span>
          </div>
          <div class="bg-emerald-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold tracking-wide shadow-sm flex items-center gap-1.5 shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            Pagado
          </div>
        </div>
      )}
    </div>

    <!-- Pied de page -->
    <div class="text-xs text-zinc-500 border-t border-zinc-800 pt-6 mb-8 text-center">
      <p>Gracias por confiar en Tienda Coches. Este documento es un comprobante oficial de compra generado de forma electrónica.</p>
    </div>

    <!-- Boutons d'action (totalement masqués à l'impression grâce à .no-print) -->
    <div class="flex justify-between items-center border-t border-zinc-800 pt-6 no-print">
      <a href="/" class="text-sm font-medium text-zinc-400 hover:text-zinc-100 transition-colors flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Volver a la tienda
      </a>
      <button 
        onclick="window.print()" 
        class="bg-zinc-100 hover:bg-white text-zinc-950 px-5 py-2.5 rounded-xl font-semibold text-sm transition-all shadow-md flex items-center gap-2 cursor-pointer">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.725 14.406v2.422c0 .726.59 1.316 1.316 1.316h8.318c.726 0 1.316-.59 1.316-1.316v-2.422M12 2.25v12.75m0 0l3.75-3.75M12 15l-3.75-3.75" />
        </svg>
        Imprimir Factura / Guardar PDF
      </button>
    </div>

  </main>

</body>
</html>
