---
import "../styles/global.css";
import LayoutBase from "../layouts/LayoutBase.astro";
import { BUCKET } from '../config';
---

<LayoutBase>
<div class="container mx-auto px-4 py-8 max-w-4xl">
  <h1 class="text-2xl font-bold mb-6 text-center">
    Tu Cesta de Compras
  </h1>

  <!-- Mensaje si la cesta está vacía -->
  <div id="cesta-vacia" class="text-center py-12 hidden">
    <p class="text-gray-500 text-lg mb-4">Tu cesta está vacía.</p>
    <a href="/" class="bg-black text-white px-6 py-2 rounded-lg hover:bg-gray-800 transition-colors">
      Ver productos
    </a>
  </div>

  <!-- Contenedor de la lista de productos -->
  <div id="contenedor-cesta" class="space-y-4">
    <!-- Se rellena dinámicamente desde el cliente con JS -->
  </div>

  <!-- Resumen del Total alineado a la derecha -->
  <section id="resumen-cesta" class="mt-8 p-4 bg-white rounded-lg shadow-sm border border-black">
    <p style="text-align: right; padding-right: 15px;" class="text-xl font-bold text-righ rounded-md">
      Total: <span id="total-precio" class="text-2xl ml-2">€0.00</span>
    </p>
  </section>

  <section id="pago">
    <button id="btn-pagar" class="block w-full text-center bg-black text-white font-medium py-3 px-6 rounded-md hover:bg-gray-800 transition-colors shadow mt-4 cursor-pointer">
      Efectuar la compra
    </button>
  </section>

</div>
</LayoutBase>

<script define:vars={{ BUCKET }}>
  console.log("BUCKET:", BUCKET);

  const contenedor = document.getElementById("contenedor-cesta");
  const mensajeVacio = document.getElementById("cesta-vacia");
  const resumen = document.getElementById("resumen-cesta");
  const totalPrecioEl = document.getElementById("total-precio");

  const obtenerCesta = () => {
    return JSON.parse(localStorage.getItem("cesta") || "[]");
  };

  const guardarCesta = (nuevaCesta) => {
    localStorage.setItem("cesta", JSON.stringify(nuevaCesta));
    window.dispatchEvent(new Event("cestaUpdated")); 
    renderizarCesta();
  };

  window.cambiarCantidad = (idProducto, cambio) => {
    let cesta = obtenerCesta();
    const index = cesta.findIndex(item => {
      const pId = item.producto?.pk_producto ?? item.pk_producto;
      return pId === idProducto;
    });

    if (index !== -1) {
      cesta[index].cantidad = (cesta[index].cantidad || 1) + cambio;

      if (cesta[index].cantidad <= 0) {
        cesta.splice(index, 1);
      }

      guardarCesta(cesta);
    }
  };

  const renderizarCesta = () => {
    const cesta = obtenerCesta();
    console.log("Cesta actual (desde carrito):", cesta);

    if (cesta.length === 0) {
      if (contenedor) contenedor.innerHTML = "";
      mensajeVacio?.classList.remove("hidden");
      resumen?.classList.add("hidden");
      return;
    }

    mensajeVacio?.classList.add("hidden");
    resumen?.classList.remove("hidden");

    let totalAcumulado = 0;

    if (contenedor) {
      contenedor.innerHTML = cesta.map(item => {
        let cantidad = item.cantidad || 1;
        // Soporta tanto si el producto está anidado (item.producto) como si está plano (item)
        let pActual = item.producto || item;
        
        let codigoProducto = pActual.pk_producto;
        let nombreProducto = pActual.nombre_producto || pActual.nombre || "Producto";

        let precioUnitario = parseFloat(pActual.precio) || 0;
        let subtotal = precioUnitario * cantidad;
        let imagenProducto = pActual.url_imagen ? `${BUCKET}${pActual.url_imagen}` : "/icons/no-image.png";
        totalAcumulado += subtotal;

        return `
          <div class="flex items-center justify-between border-b pb-4 bg-white p-4 rounded-lg shadow-sm text-black">
            <div class="flex items-center space-x-4 gap-8">
              <img width="100" height="100"
                class="object-cover rounded-md border"
                src="${imagenProducto}" 
                alt="${nombreProducto}" 
              />
              <div>
                <h3 class="font-semibold text-lg">${nombreProducto}</h3>
                <p class="text-sm text-gray-500">€${precioUnitario.toFixed(2)} c/u</p>
              </div>
            </div>

            <div class="flex items-center space-x-3">
              <span class="text-sm font-medium">Cantidad:</span>
              <div class="flex items-center bg-[#f4ece1] rounded-lg border border-gray-200 overflow-hidden">
                <button 
                  onclick="cambiarCantidad(${codigoProducto}, -1)"
                  class="px-3 py-1 font-bold text-gray-700 hover:bg-[#e8dcce] transition-colors cursor-pointer"
                  title="Restar uno"
                >-</button>
                <span class="px-4 py-1 bg-white font-semibold min-w-[2.5rem] text-center border-x border-gray-200">
                  ${cantidad}
                </span>
                <button 
                  onclick="cambiarCantidad(${codigoProducto}, 1)"
                  class="px-3 py-1 font-bold text-gray-700 hover:bg-[#e8dcce] transition-colors cursor-pointer"
                  title="Sumar uno"
                >+</button>
              </div>
            </div>

            <div class="text-right min-w-[5rem]">
              <p class="font-bold text-lg text-gray-900">
                € ${subtotal.toFixed(2)}</p>
            </div>
          </div>
        `;
      }).join("");
    }

    if (totalPrecioEl) {
      totalPrecioEl.textContent = `€ ${totalAcumulado.toFixed(2)}`;
    }

    window.dispatchEvent(new Event("cestaUpdated"));
  };

  renderizarCesta();

  const btnPagar = document.getElementById("btn-pagar");

  btnPagar?.addEventListener("click", async () => {
    const cesta = obtenerCesta();

    if (cesta.length === 0) {
      alert("Tu cesta está vacía.");
      return;
    }

    try {
      btnPagar.textContent = "Redirigiendo a Stripe...";
      btnPagar.setAttribute("disabled", "true");

      const response = await fetch("/api/crear-checkout", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ items: cesta }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Error al crear la sesión de pago");
      }

      if (data.url) {
        window.location.href = data.url;
      } else {
        throw new Error("No se recibió la URL de pago de Stripe.");
      }

    } catch (error) {
      console.error("Error en el pago:", error);
      alert("Hubo un error al procesar el pago: " + error.message);
      btnPagar.textContent = "Efectuar la compra";
      btnPagar.removeAttribute("disabled");
    }
  }); 
</script>

