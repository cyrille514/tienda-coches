---
// src/pages/carrito.astro
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Carrito de Compras - Tienda de Coches">
  <div class="max-w-4xl mx-auto py-6">
    <h1 class="text-2xl font-extrabold text-white mb-6">Tu Carrito de Compras</h1>

    <!-- Modal / Section de Succès de Compra (Masqué par défaut, affiché en JS après commande) -->
    <div id="modal-exito" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm">
      <div class="bg-white text-slate-900 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl text-center border border-slate-200">
        
        <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-600">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <h3 class="text-2xl font-extrabold text-slate-900 mb-2">¡Compra exitosa!</h3>
        <p class="text-sm text-slate-600 mb-6 leading-relaxed">
          Muchas gracias por tu compra. Tu pedido se ha registrado correctamente en nuestro sistema y hemos enviado un correo de confirmación.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <button 
            type="button"
            onclick="window.print()" 
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-xl text-xs sm:text-sm transition-all shadow-md shadow-blue-600/20 cursor-pointer flex items-center justify-center gap-1.5"
          >
            <span>🖨️</span> Ver e Imprimir Factura
          </button>

          <!-- Bouton Volver al inicio avec redirection stricte vers "/" -->
          <a 
            href="/" 
            class="bg-black hover:bg-slate-900 text-white font-semibold py-2.5 px-4 rounded-xl text-xs sm:text-sm transition-all shadow-md text-center inline-block"
          >
            Volver al inicio
          </a>
        </div>

      </div>
    </div>

    <!-- Contenu du panier... -->
    <div id="contenedor-carrito" class="space-y-4">
      <!-- Généré dynamiquement en JS -->
    </div>
  </div>
</LayoutBase>
