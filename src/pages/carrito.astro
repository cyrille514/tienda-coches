---
// src/pages/carrito.astro
import LayoutBase from "../layouts/LayoutBase.astro";
---

<LayoutBase title="Carrito de Compras - Tienda de Coches">
  
  <!-- BOUTON VOLVER -->
  <div class="mb-4">
    <button 
      onclick="window.history.back()" 
      class="inline-flex items-center gap-2 px-3 py-1.5 bg-white text-gray-700 hover:bg-gray-100 border border-gray-300 rounded-md text-sm font-semibold transition-colors cursor-pointer shadow-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
      Volver
    </button>
  </div>

  <div class="bg-[#f2ebdc] p-6 md:p-8 rounded-lg shadow-sm border border-[#e2d8c3]">
    <h1 class="text-3xl font-extrabold text-[#2a3e40] mb-6 flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      Tu Cesta de la Compra
    </h1>

    <!-- ZONE PANIER VIDE -->
    <div id="cart-empty" class="hidden text-center py-12 bg-white rounded-lg border border-gray-200">
      <p class="text-gray-500 text-lg mb-4">Tu carrito está actualmente vacío.</p>
      <a href="/productos?categoria=1" class="inline-block bg-black text-white px-6 py-2.5 rounded font-bold text-sm hover:bg-gray-800 transition-colors">
        Ver catálogo de coches
      </a>
    </div>

    <!-- TABLEAU / LISTE DU PANIER -->
    <div id="cart-content" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- LISTE DES ARTICLES (READ, UPDATE, DELETE) -->
      <div class="lg:col-span-2 space-y-4" id="cart-items-container">
        <!-- Généré dynamiquement par JavaScript -->
      </div>

      <!-- RÉCAPITULATIF DES PRIX -->
      <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 h-fit space-y-4">
        <h2 class="text-xl font-bold text-gray-900 border-b border-gray-100 pb-3">Resumen del pedido</h2>
        
        <div class="flex justify-between text-sm text-gray-600">
          <span>Subtotal (IVA incl.)</span>
          <span id="summary-subtotal" class="font-semibold">0,00 €</span>
        </div>
        <div class="flex justify-between text-sm text-gray-600">
          <span>Gastos de gestión</span>
          <span class="font-semibold text-emerald-600">Gratis</span>
        </div>

        <div class="border-t border-gray-200 pt-3 flex justify-between items-center">
          <span class="text-lg font-bold text-gray-900">Total</span>
          <span id="summary-total" class="text-2xl font-black text-black">0,00 €</span>
        </div>

        <button 
          id="btn-checkout"
          class="w-full bg-black hover:bg-gray-800 text-white font-bold py-3 px-4 rounded transition-colors shadow cursor-pointer text-center"
        >
          Finalizar compra
        </button>

        <button 
          id="btn-clear-cart"
          class="w-full bg-red-50 hover:bg-red-100 text-red-600 font-semibold py-2 px-4 rounded text-xs transition-colors cursor-pointer border border-red-200"
        >
          Vaciar cesta
        </button>
      </div>

    </div>
  </div>
</LayoutBase>

<script is:inline>
  const CART_KEY = 'tienda_coches_carrito';

  // Charger et afficher le contenu du panier (READ)
  function renderCart() {
    const cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    const emptyState = document.getElementById('cart-empty');
    const contentState = document.getElementById('cart-content');
    const itemsContainer = document.getElementById('cart-items-container');

    if (cart.length === 0) {
      emptyState.classList.remove('hidden');
      contentState.classList.add('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    contentState.classList.remove('hidden');

    // Génération du HTML pour chaque produit
    itemsContainer.innerHTML = cart.map(item => `
      <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200 flex flex-col md:flex-row items-center justify-between gap-4">
        <img src="${item.url_imagen || '/placeholder.jpg'}" alt="${item.nombre_producto}" class="w-24 h-20 object-contain rounded" />
        
        <div class="flex-1 text-center md:text-left">
          <h3 class="font-bold text-gray-900 text-lg">${item.nombre_producto}</h3>
          <p class="text-xs text-gray-500">Ref: ${item.referencia} | Color: ${item.color}</p>
          <span class="text-sm font-bold text-emerald-600">${Number(item.precio).toLocaleString('es-ES', { minimumFractionDigits: 2 })} € / ud.</span>
        </div>

        <!-- CONTROLEUR DE QUANTITE (UPDATE) -->
        <div class="flex items-center gap-2">
          <div class="flex items-center border border-gray-300 rounded">
            <button onclick="changeQty(${item.pk_producto}, -1)" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 font-bold text-gray-700">-</button>
            <span class="px-3 py-1 font-bold text-sm text-gray-800">${item.cantidad}</span>
            <button onclick="changeQty(${item.pk_producto}, 1)" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 font-bold text-gray-700">+</button>
          </div>
        </div>

        <!-- SOUS-TOTAL ET SUPPRESSION (DELETE) -->
        <div class="flex items-center gap-4">
          <span class="font-black text-lg text-gray-900 w-24 text-right">
            ${(item.precio * item.cantidad).toLocaleString('es-ES', { minimumFractionDigits: 2 })} €
          </span>
          <button onclick="removeItem(${item.pk_producto})" class="text-red-500 hover:text-red-700 p-1 cursor-pointer" title="Eliminar">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>
      </div>
    `).join('');

    // Calculs finaux
    const total = cart.reduce((sum, item) => sum + (item.precio * item.cantidad), 0);
    document.getElementById('summary-subtotal').textContent = `${total.toLocaleString('es-ES', { minimumFractionDigits: 2 })} €`;
    document.getElementById('summary-total').textContent = `${total.toLocaleString('es-ES', { minimumFractionDigits: 2 })} €`;
    
    // Sync du badge du header
    const totalItems = cart.reduce((sum, item) => sum + item.cantidad, 0);
    const badge = document.getElementById('cart-badge');
    if (badge) {
      badge.textContent = totalItems;
      if (totalItems === 0) badge.classList.add('hidden');
    }
  }

  // Modifier la quantité (UPDATE)
  window.changeQty = function(id, delta) {
    let cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    const item = cart.find(i => i.pk_producto === id);
    if (item) {
      item.cantidad += delta;
      if (item.cantidad <= 0) {
        cart = cart.filter(i => i.pk_producto !== id);
      }
      localStorage.setItem(CART_KEY, JSON.stringify(cart));
      renderCart();
    }
  };

  // Supprimer un produit (DELETE)
  window.removeItem = function(id) {
    let cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    cart = cart.filter(i => i.pk_producto !== id);
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
    renderCart();
  };

  // Vaciar carrito
  document.getElementById('btn-clear-cart')?.addEventListener('click', () => {
    if (confirm('¿Seguro que deseas vaciar toda la cesta?')) {
      localStorage.removeItem(CART_KEY);
      renderCart();
    }
  });

  // Valider la commande
  document.getElementById('btn-checkout')?.addEventListener('click', () => {
    alert('¡Gracias por tu pedido! Tu compra ha sido procesada correctamente.');
    localStorage.removeItem(CART_KEY);
    renderCart();
  });

  // Chargement initial
  document.addEventListener('DOMContentLoaded', renderCart);
</script>
