---
// src/pages/carrito.astro
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Carrito de Compras - Tienda de Coches">
  <div class="max-w-4xl mx-auto py-8 sm:py-12 px-4 sm:px-6 lg:px-8 space-y-6 text-zinc-100">
    
    <!-- Cabecera de la sección -->
    <div class="flex items-center justify-between pb-4 border-b border-zinc-800/80">
      <div>
        <h1 class="text-xl sm:text-2xl font-semibold tracking-tight text-white">
          Tu Carrito de Compras
        </h1>
        <p class="text-xs sm:text-sm text-zinc-400 mt-0.5">
          Vehículos seleccionados para reserva y tramitación.
        </p>
      </div>
      <button 
        id="btn-reset-cart" 
        type="button" 
        class="h-9 px-3 bg-red-950/40 hover:bg-red-950/70 border border-red-900/60 text-red-400 text-xs font-medium rounded-lg transition-colors cursor-pointer flex items-center gap-1.5"
      >
        <span>🗑️</span>
        <span class="hidden sm:inline">Vaciar carrito</span>
      </button>
    </div>

    <!-- Modal de confirmación de comando / éxito (si ?success=true) -->
    <div id="modal-exito" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/80 backdrop-blur-sm">
      <div class="bg-zinc-900 text-zinc-100 rounded-2xl p-6 sm:p-8 max-w-md w-full shadow-2xl text-center border border-zinc-800 space-y-4">
        <div class="w-12 h-12 bg-emerald-950/60 border border-emerald-800/60 rounded-xl flex items-center justify-center mx-auto text-emerald-400">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div class="space-y-1">
          <h3 class="text-lg font-semibold text-white">¡Pago exitoso con Stripe!</h3>
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
            Muchas gracias por tu compra. Tu pago se ha procesado correctamente y tu pedido está en curso.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-2.5 justify-center pt-2">
          <button 
            type="button"
            onclick="window.print()" 
            class="h-10 px-4 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-semibold rounded-lg text-xs transition-colors flex items-center justify-center gap-2 cursor-pointer border border-zinc-700"
          >
            <span>🖨️</span> Ver Factura
          </button>
          <a 
            href="/" 
            class="h-10 px-4 bg-zinc-100 hover:bg-white text-zinc-950 font-semibold rounded-lg text-xs transition-colors flex items-center justify-center cursor-pointer"
          >
            Volver al inicio
          </a>
        </div>
      </div>
    </div>

    <!-- Contenedor dinámico de los artículos -->
    <div id="contenedor-carrito" class="space-y-4">
      <div class="p-8 text-center bg-zinc-900/40 rounded-xl border border-zinc-800/80 text-zinc-400 text-sm">
        Cargando tu carrito...
      </div>
    </div>
  </div>
</LayoutBase>

<script>
  // Verificar si Stripe redirigió con éxito
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('success') === 'true') {
    localStorage.removeItem("cesta");
    localStorage.removeItem("tienda_coches_carrito");
    window.dispatchEvent(new Event('cestaUpdated'));
    
    window.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('modal-exito');
      if (modal) modal.classList.remove('hidden');
    });
  }

  function renderCarrito() {
    const container = document.getElementById('contenedor-carrito');
    if (!container) return;

    let cesta = [];
    try {
      const rawCesta = localStorage.getItem("cesta") || localStorage.getItem("tienda_coches_carrito") || "[]";
      const parsed = JSON.parse(rawCesta);
      cesta = Array.isArray(parsed[0]) ? parsed[0] : parsed;
      if (!Array.isArray(cesta)) cesta = [];
    } catch (e) {
      cesta = [];
    }

    if (cesta.length === 0) {
      container.innerHTML = `
        <div class="p-10 text-center bg-zinc-900/40 rounded-xl border border-zinc-800/80 space-y-4">
          <p class="text-zinc-400 text-sm font-medium">Tu carrito está vacío.</p>
          <a href="/" class="inline-flex items-center justify-center h-10 px-4 bg-zinc-100 hover:bg-white text-zinc-950 text-xs font-semibold rounded-lg transition-colors">
            Explorar catálogo
          </a>
        </div>
      `;
      return;
    }

    let total = 0;
    const itemsHtml = cesta.map((item: any, index: number) => {
      const precio = Number(item.precio || item.price || 0);
      const cantidad = Number(item.cantidad || 1);
      const subtotal = precio * cantidad;
      total += subtotal;

      const nombre = item.nombre_producto || item.nombre || item.title || 'Vehículo';
      const imagen = item.url_imagen || item.imagen || '';

      return `
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 bg-zinc-900/40 rounded-xl border border-zinc-800/80 gap-4">
          <div class="flex items-center gap-3.5 w-full sm:w-auto">
            ${imagen ? `<img src="${imagen}" alt="${nombre}" class="w-16 h-12 object-cover rounded-lg border border-zinc-800 shrink-0" />` : ''}
            <div class="min-w-0 flex-1">
              <h4 class="font-semibold text-sm text-zinc-100 truncate">${nombre}</h4>
              <p class="text-xs text-zinc-500 mt-0.5 font-mono">${precio.toLocaleString('es-ES')} € × ${cantidad}</p>
            </div>
          </div>
          <div class="flex items-center justify-between sm:justify-end gap-4 w-full sm:w-auto pt-3 sm:pt-0 border-t sm:border-t-0 border-zinc-800/80">
            <span class="font-semibold text-white font-mono tabular-nums text-sm sm:text-base">${subtotal.toLocaleString('es-ES')} €</span>
            <button data-index="${index}" class="btn-eliminar h-8 px-2.5 rounded-lg text-xs font-medium text-red-400 hover:text-red-300 hover:bg-red-950/40 border border-transparent hover:border-red-900/50 transition-colors cursor-pointer" title="Eliminar">
              Eliminar
            </button>
          </div>
        </div>
      `;
    }).join('');

    container.innerHTML = `
      <div class="space-y-3">
        ${itemsHtml}
      </div>
      <div class="p-5 bg-zinc-900/40 rounded-xl border border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 mt-6">
        <div>
          <span class="text-xs text-zinc-400 block">Total a pagar:</span>
          <span class="text-xl sm:text-2xl font-semibold text-white font-mono tabular-nums">${total.toLocaleString('es-ES')} €</span>
        </div>
        <button id="btn-stripe-checkout" class="w-full sm:w-auto h-11 px-6 bg-zinc-100 hover:bg-white text-zinc-950 font-semibold text-xs sm:text-sm rounded-lg transition-colors shadow-sm cursor-pointer flex items-center justify-center gap-2">
          <span>💳</span> Pagar con Stripe
        </button>
      </div>
    `;

    // Supresión de un artículo
    document.querySelectorAll('.btn-eliminar').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).dataset.index);
        cesta.splice(idx, 1);
        localStorage.setItem("cesta", JSON.stringify(cesta));
        window.dispatchEvent(new Event('cestaUpdated'));
        renderCarrito();
      });
    });

    // Llamada a la API de Stripe al hacer clic
    const btnStripe = document.getElementById('btn-stripe-checkout');
    if (btnStripe) {
      btnStripe.addEventListener('click', async () => {
        btnStripe.textContent = 'Conectando con Stripe...';
        btnStripe.setAttribute('disabled', 'true');

        try {
          const response = await fetch('/api/create-stripe-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: cesta }),
          });

          const data = await response.json();
          if (data.url) {
            window.location.href = data.url; // Redirección a la pasarela de Stripe
          } else {
            throw new Error(data.error || 'Error al crear la sesión de Stripe');
          }
        } catch (err: any) {
          alert('Hubo un error al procesar el pago: ' + err.message);
          btnStripe.textContent = '💳 Pagar con Stripe';
          btnStripe.removeAttribute('disabled');
        }
      });
    }
  }

  // Botón de restablecimiento de emergencia
  const btnReset = document.getElementById('btn-reset-cart');
  if (btnReset) {
    btnReset.addEventListener('click', () => {
      localStorage.removeItem("cesta");
      localStorage.removeItem("tienda_coches_carrito");
      window.dispatchEvent(new Event('cestaUpdated'));
      renderCarrito();
    });
  }

  renderCarrito();
  window.addEventListener('cestaUpdated', renderCarrito);
</script>
