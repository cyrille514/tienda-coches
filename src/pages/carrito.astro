---
// src/pages/carrito.astro
import LayoutBase from '../layouts/LayoutBase.astro';
import { BUCKET } from '../config';
---

<LayoutBase title="Tu Cesta de Compras | Exclusive Motors">
  <div class="max-w-4xl mx-auto py-2">
    <h1 class="text-xl sm:text-2xl font-bold text-white text-center mb-6">Tu Cesta de Compras</h1>

    <!-- Zone dynamique du panier -->
    <div id="cart-container" class="space-y-4">
      <p class="text-slate-400 text-center py-8 text-sm">Cargando tu cesta...</p>
    </div>

    <!-- Résumé et Total -->
    <div id="cart-summary" class="mt-6 hidden space-y-4">
      <div style="background-color: #0f172a !important; border: 1px solid #1e293b !important;" class="p-4 rounded-2xl flex justify-between items-center shadow-lg">
        <span class="text-sm font-semibold text-slate-300">Total a pagar:</span>
        <span id="cart-total-price" class="text-lg font-extrabold text-blue-400">€ 0.00</span>
      </div>

      <button 
        id="btn-checkout"
        type="button"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl transition-all shadow-lg shadow-blue-600/20 text-sm cursor-pointer"
      >
        Efectuar la compra avec Stripe
      </button>
    </div>
  </div>
</LayoutBase>

<script is:inline>
  const BUCKET_URL = "https://aahvngawggsthhubqskx.supabase.co/storage/v1/object/public/coches/";

  function getCart() {
    try {
      const raw = localStorage.getItem("cesta") || localStorage.getItem("tienda_coches_carrito") || "[]";
      return JSON.parse(raw);
    } catch (e) {
      return [];
    }
  }

  function saveAndNotify(cesta) {
    const jsonStr = JSON.stringify(cesta);
    localStorage.setItem("cesta", jsonStr);
    localStorage.setItem("tienda_coches_carrito", jsonStr);
    window.dispatchEvent(new Event("cestaUpdated"));
    renderCart();
  }

  const renderCart = () => {
    const container = document.getElementById("cart-container");
    const summary = document.getElementById("cart-summary");
    const totalPriceEl = document.getElementById("cart-total-price");

    if (!container) return;

    const cesta = getCart();

    if (cesta.length === 0) {
      container.innerHTML = `
        <div style="background-color: #0f172a !important; border: 1px solid #1e293b !important;" class="p-8 rounded-2xl text-center space-y-4 shadow-lg">
          <p class="text-slate-400 text-sm">Tu cesta está vacía en este momento.</p>
          <a href="/productos?categoria=1" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2.5 rounded-xl text-xs transition-colors">
            Explorar vehículos
          </a>
        </div>
      `;
      if (summary) summary.classList.add("hidden");
      return;
    }

    let total = 0;

    container.innerHTML = cesta.map((item, index) => {
      const precio = Number(item.precio) || Number(item.precio_producto) || Number(item.price) || 0;
      const cantidad = item.cantidad || 1;
      const subtotal = precio * cantidad;
      total += subtotal;

      // Récupération précise du nom du véhicule selon la structure stockée
      const nombreProducto = item.nombre || item.nom_producto || item.modelo || item.title || item.titulo || item.marca || "Véhicule Sélectionné";

      let imagenNombre = item.imagen_url || item.imagen || item.foto || item.img || "";
      let imagenFinal = "";

      if (imagenNombre.startsWith("http")) {
        imagenFinal = imagenNombre;
      } else if (imagenNombre) {
        imagenFinal = `${BUCKET_URL}${imagenNombre}`;
      } else {
        imagenFinal = `${BUCKET_URL}showroom-coches.jpg`;
      }

      return `
        <div style="background-color: #0f172a !important; border: 1px solid #1e293b !important;" class="p-4 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4 shadow-lg">
          
          <!-- Image & Info -->
          <div class="flex items-center gap-4 w-full sm:w-auto">
            <div class="w-20 h-16 rounded-xl overflow-hidden bg-slate-950 border border-slate-800 shrink-0">
              <img src="${imagenFinal}" alt="${nombreProducto}" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=500&q=80'" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">${nombreProducto}</h3>
              <p class="text-xs text-slate-400 mt-0.5">€ ${precio.toFixed(2)} c/u</p>
            </div>
          </div>

          <!-- Controls Quantité & Prix -->
          <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto">
            
            <div class="flex items-center bg-slate-950 rounded-xl border border-slate-800 p-1">
              <button 
                type="button"
                onclick="window.changeQuantity(${index}, -1)"
                class="w-7 h-7 flex items-center justify-center text-slate-300 hover:bg-slate-800 rounded-lg transition-colors text-xs font-bold cursor-pointer"
              >-</button>
              <span class="w-8 text-center text-xs font-bold text-white">${cantidad}</span>
              <button 
                type="button"
                onclick="window.changeQuantity(${index}, 1)"
                class="w-7 h-7 flex items-center justify-center text-slate-300 hover:bg-slate-800 rounded-lg transition-colors text-xs font-bold cursor-pointer"
              >+</button>
            </div>

            <div class="flex items-center gap-4">
              <span class="text-sm font-extrabold text-blue-400">€ ${subtotal.toFixed(2)}</span>
              <button 
                type="button"
                onclick="window.removeItem(${index})"
                class="text-slate-500 hover:text-red-400 transition-colors p-1 cursor-pointer"
                title="Eliminar producto"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>

          </div>
        </div>
      `;
    }).join("");

    if (totalPriceEl) totalPriceEl.textContent = `€ ${total.toFixed(2)}`;
    if (summary) summary.classList.remove("hidden");
  };

  window.changeQuantity = function(index, delta) {
    let cesta = getCart();
    if (cesta[index]) {
      cesta[index].cantidad = (cesta[index].cantidad || 1) + delta;
      if (cesta[index].cantidad <= 0) {
        cesta.splice(index, 1);
      }
    }
    saveAndNotify(cesta);
  };

  window.removeItem = function(index) {
    let cesta = getCart();
    cesta.splice(index, 1);
    saveAndNotify(cesta);
  };

  // Intégration de l'appel de paiement Stripe au clic sur le bouton
  document.addEventListener("DOMContentLoaded", () => {
    renderCart();

    const btnCheckout = document.getElementById("btn-checkout");
    if (btnCheckout) {
      btnCheckout.addEventListener("click", async () => {
        const cesta = getCart();
        if (cesta.length === 0) return;

        try {
          btnCheckout.textContent = "Redirigiendo a Stripe...";
          btnCheckout.disabled = true;

          // Appel vers votre endpoint backend/API de création de session Stripe
          const response = await fetch("/api/create-checkout-session", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ items: cesta }),
          });

          const data = await response.json();

          if (data.url) {
            window.location.href = data.url; // Redirection vers la page de paiement Stripe
          } else {
            alert("Erreur lors de la création de la session de paiement.");
            btnCheckout.textContent = "Efectuar la compra avec Stripe";
            btnCheckout.disabled = false;
          }
        } catch (error) {
          console.error("Erreur Stripe:", error);
          alert("Une erreur est survenue lors de la connexion à Stripe.");
          btnCheckout.textContent = "Efectuar la compra avec Stripe";
          btnCheckout.disabled = false;
        }
      });
    }
  });
</script>