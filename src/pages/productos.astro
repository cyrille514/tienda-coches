---
// src/pages/productos.astro
import LayoutBase from '@/layouts/LayoutBase.astro';
import VehicleCard from '@/components/VehicleCard.astro';
import { supabase } from '@/lib/supabase';

const categoriaParam = Astro.url.searchParams.get('categoria');
const categoriaId = categoriaParam ? Number(categoriaParam) : 1;

// Récupération de la catégorie active
const { data: categoriaActual } = await supabase
  .from('categorias')
  .select('*')
  .eq('pk_categoria', categoriaId)
  .maybeSingle();

// Récupération des produits de la catégorie
const { data: productos } = await supabase
  .from('productos')
  .select('*')
  .eq('fk_categoria', categoriaId);

const nombreCategoria = categoriaActual?.nom_categoria || `Categoría ${categoriaId}`;
---

<LayoutBase title={`${nombreCategoria} | Tienda de Coches`} categoriaActivaId={categoriaId}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    
    <!-- BOUTON VOLVER -->
    <div class="mb-4 sm:mb-6">
      <button 
        onclick="window.history.back()" 
        class="inline-flex items-center gap-2 px-3.5 py-2 bg-white text-blue-700 hover:bg-gray-100 border border-gray-300 rounded-lg text-sm font-bold transition-colors cursor-pointer shadow-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"/>
          <path d="M12 19l-7-7 7-7"/>
        </svg>
        Volver
      </button>
    </div>

    <!-- EN-TÊTE DE LA CATÉGORIE -->
    <div class="bg-white p-5 sm:p-6 rounded-xl shadow-sm border border-gray-100 mb-6 sm:mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-gray-800 mb-2">{nombreCategoria}</h2>
      {categoriaActual?.descripcion_categoria && (
        <p class="text-gray-600 text-sm sm:text-base leading-relaxed">{categoriaActual.descripcion_categoria}</p>
      )}
    </div>

    <!-- GRILLE RESPONSIVE DE VÉHICULES -->
    {productos && productos.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {productos.map((producto) => (
          <VehicleCard vehiculo={producto} />
        ))}
      </div>
    ) : (
      <div class="bg-white p-8 sm:p-12 rounded-xl text-center shadow-sm border border-gray-100">
        <p class="text-gray-500 italic text-sm sm:text-base">No hay vehículos disponibles en esta categoría actualmente.</p>
      </div>
    )}

  </div>
</LayoutBase>