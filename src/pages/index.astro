---
// src/pages/index.astro
import LayoutBase from '../layouts/LayoutBase.astro';
import { BUCKET } from '../config';
import { pool } from '../lib/db'; // Assurez-vous que votre pool de connexion PostgreSQL est importé ici

// 1. Paramètres de pagination
const limit = 6; // Nombre de véhicules par page
const page = Number(Astro.url.searchParams.get('page')) || 1;
const offset = (page - 1) * limit;

let productos = [];
let totalPages = 1;

try {
  // 2. Récupération des véhicules paginés avec des requêtes préparées sécurisées
  const query = 'SELECT * FROM productos ORDER BY id DESC LIMIT $1 OFFSET $2';
  const result = await pool.query(query, [limit, offset]);
  productos = result.rows;

  // 3. Récupération du nombre total pour calculer les pages
  const countResult = await pool.query('SELECT COUNT(*) FROM productos');
  const totalProductos = parseInt(countResult.rows[0].count, 10);
  totalPages = Math.ceil(totalProductos / limit) || 1;
} catch (error) {
  console.error('Error al cargar los productos:', error);
}
---

<LayoutBase title="Inicio - Tienda de Coches | Exclusive Motors">
  <!-- Hero / Showroom Exclusivo -->
  <section class="relative w-full h-[400px] sm:h-[480px] lg:h-[540px] overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-900 group mb-12">
    <img 
      src={`${BUCKET}showroom-coches.jpg`} 
      alt="Showroom de Coches" 
      class="w-full h-full object-cover object-[70%_center] group-hover:scale-102 transition-transform duration-700 ease-out opacity-75"
      onerror="this.src='https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=1200&auto=format&fit=crop';"
    />
    
    <!-- Gradiente de contraste inferior -->
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent flex items-end p-6 sm:p-10">
      <div class="max-w-xl space-y-2">
        <span class="inline-block text-[11px] font-semibold uppercase tracking-widest text-zinc-400">
          Colección Auditada 2026
        </span>
        <h1 class="text-2xl sm:text-4xl font-semibold tracking-tight text-white leading-tight">
          Showroom Exclusivo
        </h1>
        <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed max-w-lg">
          Descubre nuestra selecta gama de vehículos de alta gama en un espacio diseñado para ofrecer máxima transparencia y confort.
        </p>
      </div>
    </div>
  </section>

  <!-- Grille de Produits / Catalogue -->
  <section class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold text-white tracking-tight">Vehículos Disponibles</h2>
      <span class="text-xs text-zinc-400">Página {page} de {totalPages}</span>
    </div>

    {productos.length === 0 ? (
      <div class="text-center py-12 bg-zinc-900 border border-zinc-800 rounded-xl">
        <p class="text-sm text-zinc-400">No hay vehículos disponibles en este momento.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {productos.map((producto) => (
          <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden flex flex-col group">
            <div class="h-48 overflow-hidden bg-zinc-950 relative">
              <img 
                src={producto.imagen || 'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=600&auto=format&fit=crop'} 
                alt={producto.nombre} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-5 flex flex-col flex-grow justify-between space-y-4">
              <div class="space-y-1">
                <h3 class="text-sm font-semibold text-white">{producto.nombre}</h3>
                <p class="text-xs text-zinc-400 line-clamp-2">{producto.descripcion}</p>
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-zinc-800/80">
                <span class="text-sm font-bold text-white">{Number(producto.precio).toLocaleString('es-ES')} €</span>
                <a href={`/producto/${producto.id}`} class="px-3 py-1.5 bg-zinc-100 hover:bg-white text-zinc-950 text-xs font-semibold rounded-lg transition-colors">
                  Ver Detalles
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Barres de Navigation (Pagination UI) -->
    {totalPages > 1 && (
      <nav class="flex justify-center items-center gap-3 mt-10 mb-12">
        {page > 1 ? (
          <a href={`/?page=${page - 1}`} class="px-4 py-2 bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white rounded-lg text-xs transition-colors">
            ← Anterior
          </a>
        ) : (
          <span class="px-4 py-2 bg-zinc-900/50 border border-zinc-800/50 text-zinc-600 rounded-lg text-xs cursor-not-allowed">
            ← Anterior
          </span>
        )}
        
        <span class="text-xs text-zinc-400 px-2">
          Página <strong class="text-zinc-100">{page}</strong> de <strong class="text-zinc-100">{totalPages}</strong>
        </span>

        {page < totalPages ? (
          <a href={`/?page=${page + 1}`} class="px-4 py-2 bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white rounded-lg text-xs transition-colors">
            Siguiente →
          </a>
        ) : (
          <span class="px-4 py-2 bg-zinc-900/50 border border-zinc-800/50 text-zinc-600 rounded-lg text-xs cursor-not-allowed">
            Siguiente →
          </span>
        )}
      </nav>
    )}
  </section>
</LayoutBase>
