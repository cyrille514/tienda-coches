---
// src/pages/index.astro
import LayoutBase from '../layouts/LayoutBase.astro';
import { BUCKET } from '../config';
---

<LayoutBase title="Inicio - Tienda de Coches | Exclusive Motors">
  <!-- Hero / Showroom Exclusivo -->
  <section class="relative w-full h-[400px] sm:h-[480px] lg:h-[540px] overflow-hidden rounded-2xl border border-zinc-800/80 bg-zinc-900 group">
    <img 
      src={`${BUCKET}showroom-coches.jpg`} 
      alt="Showroom de Coches" 
      class="w-full h-full object-cover object-[70%_center] group-hover:scale-102 transition-transform duration-700 ease-out opacity-75"
      onerror="this.src='https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=1200&auto=format&fit=crop';"
    />
    
    <!-- Gradiente de contraste inferior -->
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent flex items-end p-6 sm:p-10">
      <div class="max-w-xl space-y-2">
        <span class="inline-block text-[11px] font-semibold uppercase tracking-widest text-zinc-400">
          Colección Auditada 2026
        </span>
        <h1 class="text-2xl sm:text-4xl font-semibold tracking-tight text-white leading-tight">
          Showroom Exclusivo
        </h1>
        <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed max-w-lg">
          Descubre nuestra selecta gama de vehículos de alta gama en un espacio diseñado para ofrecer máxima transparencia y confort.
        </p>
      </div>
    </div>
  </section>
</LayoutBase>
