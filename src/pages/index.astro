---
import VehicleCard from '../components/VehicleCard.astro';
import vehiclesData from '../data/vehicles.json';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AutoStore Vehicules</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" />
</head>
<body class="bg-slate-50 min-h-screen text-slate-800 antialiased p-6">

  <div class="max-w-7xl mx-auto space-y-6">

    <!-- Header -->
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white font-bold text-xl shadow-md shadow-indigo-200">
          ⚡
        </div>
        <div>
          <h1 class="text-xl font-bold text-slate-900">AutoStore Vehicules</h1>
          <p class="text-xs text-slate-500">Panel E-Commerce & Control de Stock</p>
        </div>
      </div>
      
      <button 
        onclick="openModal()" 
        class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-sm shadow-indigo-200 hover:shadow-indigo-300 self-start md:self-auto cursor-pointer"
      >
        + Nuevo Vehículo
      </button>
    </header>

    <!-- Navigation Filters & Search -->
    <div class="flex flex-col md:flex-row justify-between items-stretch md:items-center gap-4 bg-white p-4 rounded-2xl shadow-sm border border-slate-100">
      
      <!-- Boutons de Filtres par Marque -->
      <div class="flex flex-wrap gap-2 bg-slate-100 p-1.5 rounded-xl">
        <button data-brand="all" class="filter-btn active-filter px-4 py-2 text-xs font-semibold rounded-lg bg-indigo-600 text-white shadow-sm transition-all cursor-pointer">
          Todos
        </button>
        <button data-brand="Peugeot" class="filter-btn px-4 py-2 text-xs font-semibold rounded-lg text-slate-700 hover:bg-slate-200 transition-all cursor-pointer">
          PEUGEOT
        </button>
        <button data-brand="BMW" class="filter-btn px-4 py-2 text-xs font-semibold rounded-lg text-slate-700 hover:bg-slate-200 transition-all cursor-pointer">
          BMW
        </button>
        <button data-brand="Tesla" class="filter-btn px-4 py-2 text-xs font-semibold rounded-lg text-slate-700 hover:bg-slate-200 transition-all cursor-pointer">
          TESLA
        </button>
      </div>

      <!-- Recherche en direct -->
      <div class="relative min-w-[260px]">
        <input 
          type="text" 
          id="searchInput" 
          placeholder="Buscar vehículo..." 
          class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:border-indigo-500 transition-colors"
        />
        <span class="absolute left-3 top-2.5 text-xs text-slate-400">🔍</span>
      </div>

    </div>

    <!-- Product Grid & Cart Container -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      
      <!-- Product Grid -->
      <div id="productGrid" class="lg:col-span-3 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {vehiclesData.map((vehicle) => (
          <VehicleCard vehicle={vehicle} />
        ))}
      </div>

      <!-- Sidebar Cart (Fixé avec défilement pour les articles) -->
      <aside class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between min-h-[400px]">
        <div>
          <!-- Cart Header -->
          <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-3">
            <h2 class="font-bold text-slate-900 text-base">Carrito</h2>
            <span id="cartCount" class="bg-indigo-50 text-indigo-600 text-xs font-bold px-2.5 py-0.5 rounded-full">0</span>
          </div>

          <!-- Liste des articles (Scrollable si plus de 3 articles) -->
          <div id="cartList" class="space-y-3 max-h-64 overflow-y-auto pr-1">
            <p id="emptyCartMsg" class="text-xs text-slate-400 text-center py-8">El carrito está vacío</p>
          </div>
        </div>

        <!-- Cart Footer (Total et Bouton Fixe) -->
        <div class="border-t border-slate-100 pt-4 mt-4 space-y-4">
          <div class="flex justify-between items-center text-sm font-bold text-slate-900">
            <span>Total:</span>
            <span id="cartTotal">0 €</span>
          </div>
          
          <button 
            type="button"
            onclick="openPaymentModal()" 
            class="w-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold py-3 rounded-xl transition-colors shadow-sm cursor-pointer"
          >
            Procesar al pago
          </button>
        </div>
      </aside>

    </div>

  </div>

  <!-- Modal Nuevo Vehículo -->
  <div id="vehicleModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-100 max-w-md w-full p-6 relative">
      
      <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-4">
        <h2 class="text-lg font-bold text-slate-900">Añadir Nuevo Vehículo</h2>
        <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-lg font-bold cursor-pointer">✕</button>
      </div>

      <form id="addVehicleForm" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Nombre del Vehículo</label>
          <input type="text" id="modalName" required placeholder="Ex: Tesla Model 3" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Marca</label>
            <input type="text" id="modalBrand" required placeholder="Ex: Tesla" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Categoría</label>
            <select id="modalCategory" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500">
              <option value="Coches">Coches</option>
              <option value="Motos">Motos</option>
              <option value="Accesorios">Accesorios</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Precio (€)</label>
            <input type="number" id="modalPrice" required min="0" step="0.01" placeholder="25000" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Stock</label>
            <input type="number" id="modalStock" required min="1" placeholder="5" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">URL de la Imagen</label>
          <input type="url" id="modalImage" required placeholder="https://images.unsplash.com/photo-..." class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500" />
        </div>

        <div class="flex gap-3 pt-2">
          <button type="button" onclick="closeModal()" class="w-1/2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold py-2.5 rounded-xl transition-colors cursor-pointer">
            Cancelar
          </button>
          <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold py-2.5 rounded-xl transition-colors shadow-sm shadow-indigo-200 cursor-pointer">
            Guardar
          </button>
        </div>
      </form>

    </div>
  </div>

  <!-- Modal Selección de Pago -->
  <div id="paymentModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-100 max-w-md w-full p-6 relative">
      
      <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-4">
        <h2 class="text-lg font-bold text-slate-900">Método de Pago</h2>
        <button onclick="closePaymentModal()" class="text-slate-400 hover:text-slate-600 text-lg font-bold cursor-pointer">✕</button>
      </div>

      <div class="space-y-4">
        <p class="text-xs text-slate-500">Total a pagar: <span id="modalPaymentTotal" class="font-bold text-indigo-600 text-sm">0 €</span></p>

        <div class="space-y-2">
          <label class="cursor-pointer block">
            <input type="radio" name="payment" value="Tarjeta Bancaria" checked class="peer sr-only" />
            <div class="p-3 border border-slate-200 rounded-xl flex items-center justify-between text-xs font-semibold text-slate-700 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:text-indigo-600 transition-all">
              <span>💳 Tarjeta Bancaria</span>
              <span class="text-slate-400">➜</span>
            </div>
          </label>

          <label class="cursor-pointer block">
            <input type="radio" name="payment" value="PayPal" class="peer sr-only" />
            <div class="p-3 border border-slate-200 rounded-xl flex items-center justify-between text-xs font-semibold text-slate-700 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:text-indigo-600 transition-all">
              <span>🅿️ PayPal</span>
              <span class="text-slate-400">➜</span>
            </div>
          </label>

          <label class="cursor-pointer block">
            <input type="radio" name="payment" value="Bizum" class="peer sr-only" />
            <div class="p-3 border border-slate-200 rounded-xl flex items-center justify-between text-xs font-semibold text-slate-700 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:text-indigo-600 transition-all">
              <span>📱 Bizum</span>
              <span class="text-slate-400">➜</span>
            </div>
          </label>
        </div>

        <div class="flex gap-3 pt-3">
          <button type="button" onclick="closePaymentModal()" class="w-1/2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold py-2.5 rounded-xl transition-colors cursor-pointer">
            Cancelar
          </button>
          <button type="button" onclick="processPayment()" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold py-2.5 rounded-xl transition-colors shadow-sm shadow-indigo-200 cursor-pointer">
            Pagar Ahora
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- JavaScript Client-Side -->
  <script is:inline>
    // Variables de estado
    var cart = [];
    var currentBrand = 'all';
    var searchQuery = '';

    // Gestion Modal Vehiculo
    function openModal() {
      const modal = document.getElementById('vehicleModal');
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closeModal() {
      const modal = document.getElementById('vehicleModal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    // Gestion Modal Pago
    function openPaymentModal() {
      if (cart.length === 0) {
        alert("El carrito está vacío.");
        return;
      }

      const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const modalPaymentTotal = document.getElementById('modalPaymentTotal');
      if (modalPaymentTotal) {
        modalPaymentTotal.textContent = totalPrice.toLocaleString('es-ES') + ' €';
      }

      const modal = document.getElementById('paymentModal');
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closePaymentModal() {
      const modal = document.getElementById('paymentModal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    function processPayment() {
      const selectedPayment = document.querySelector('input[name="payment"]:checked')?.value || 'Tarjeta Bancaria';
      alert(`¡Pago realizado con éxito mediante ${selectedPayment}!`);
      cart = [];
      renderCart();
      closePaymentModal();
    }

    // Fermeture lors du clic extérieur
    window.addEventListener('click', (e) => {
      const vehicleModal = document.getElementById('vehicleModal');
      const paymentModal = document.getElementById('paymentModal');
      if (e.target === vehicleModal) closeModal();
      if (e.target === paymentModal) closePaymentModal();
    });

    // Fonctions du Panier
    function addToCart(vehicle) {
      const existing = cart.find(item => item.id === vehicle.id);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ ...vehicle, quantity: 1 });
      }
      renderCart();
    }

    function updateQuantity(id, change) {
      const item = cart.find(i => i.id === id);
      if (item) {
        item.quantity += change;
        if (item.quantity <= 0) {
          cart = cart.filter(i => i.id !== id);
        }
      }
      renderCart();
    }

    function removeFromCart(id) {
      cart = cart.filter(item => item.id !== id);
      renderCart();
    }

    function renderCart() {
      const cartList = document.getElementById('cartList');
      const cartCount = document.getElementById('cartCount');
      const cartTotal = document.getElementById('cartTotal');

      if (!cartList) return;

      const totalQuantity = cart.reduce((sum, item) => sum + item.quantity, 0);
      const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

      cartCount.textContent = totalQuantity;
      cartTotal.textContent = totalPrice.toLocaleString('es-ES') + ' €';

      if (cart.length === 0) {
        cartList.innerHTML = '<p class="text-xs text-slate-400 text-center py-8">El carrito está vacío</p>';
        return;
      }

      cartList.innerHTML = cart.map(item => `
        <div class="flex items-center justify-between gap-2 p-2 bg-slate-50 rounded-xl">
          <div class="flex-1 min-w-0">
            <p class="text-xs font-bold text-slate-900 truncate">${item.name}</p>
            <p class="text-xs text-slate-500">${item.price.toLocaleString('es-ES')} €</p>
          </div>

          <!-- Boutons + / - -->
          <div class="flex items-center gap-1 bg-white border border-slate-200 rounded-lg p-1">
            <button onclick="updateQuantity(${item.id}, -1)" class="w-5 h-5 flex items-center justify-center text-xs font-bold text-slate-600 hover:bg-slate-100 rounded">
              -
            </button>
            <span class="text-xs font-bold px-1 text-slate-800">${item.quantity}</span>
            <button onclick="updateQuantity(${item.id}, 1)" class="w-5 h-5 flex items-center justify-center text-xs font-bold text-slate-600 hover:bg-slate-100 rounded">
              +
            </button>
          </div>

          <!-- Bouton Supprimer -->
          <button onclick="removeFromCart(${item.id})" class="text-xs text-rose-500 hover:text-rose-700 font-bold px-1.5 py-1">
            ✕
          </button>
        </div>
      `).join('');
    }

    // Logique des Filtres par Marque & Recherche
    function filterProducts() {
      const cards = document.querySelectorAll('.vehicle-card');

      cards.forEach(card => {
        const cardBrand = (card.getAttribute('data-brand') || '').toLowerCase();
        const cardName = (card.getAttribute('data-name') || '').toLowerCase();

        const matchesBrand = (currentBrand === 'all') || (cardBrand === currentBrand.toLowerCase());
        const matchesSearch = cardName.includes(searchQuery.toLowerCase());

        if (matchesBrand && matchesSearch) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    // Ecouteurs d'événements
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const searchInput = document.getElementById('searchInput');
      const form = document.getElementById('addVehicleForm');
      const productGrid = document.getElementById('productGrid');

      // Boutons Filtres Marque
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
            b.classList.add('text-slate-700');
          });
          btn.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
          btn.classList.remove('text-slate-700');

          currentBrand = btn.getAttribute('data-brand');
          filterProducts();
        });
      });

      // Champ Recherche
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value;
          filterProducts();
        });
      }

      // Ajout Nouveau Véhicule
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();

          const newVehicle = {
            id: Date.now(),
            name: document.getElementById('modalName').value,
            brand: document.getElementById('modalBrand').value,
            category: document.getElementById('modalCategory').value,
            price: parseFloat(document.getElementById('modalPrice').value),
            stock: parseInt(document.getElementById('modalStock').value),
            image: document.getElementById('modalImage').value
          };

          const card = document.createElement('div');
          card.setAttribute('data-category', newVehicle.category);
          card.setAttribute('data-brand', newVehicle.brand);
          card.setAttribute('data-name', newVehicle.name.toLowerCase());
          card.className = "vehicle-card bg-white rounded-2xl p-4 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between";

          card.innerHTML = `
            <div>
              <div class="relative h-44 rounded-xl overflow-hidden mb-4 bg-slate-100">
                <img src="${newVehicle.image}" alt="${newVehicle.name}" class="w-full h-full object-cover" />
                <span class="absolute top-3 left-3 bg-slate-900/80 backdrop-blur-md text-white text-xs font-medium px-3 py-1 rounded-full">
                  ${newVehicle.category}
                </span>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-1 line-clamp-1">${newVehicle.name}</h3>
              <p class="text-xs text-slate-500 mb-3">${newVehicle.brand}</p>
            </div>

            <div>
              <div class="flex justify-between items-center mb-4">
                <span class="text-xl font-extrabold text-indigo-600">${newVehicle.price.toLocaleString('es-ES')} €</span>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-600">
                  Stock: ${newVehicle.stock}
                </span>
              </div>
              <button 
                type="button"
                data-id="${newVehicle.id}"
                data-name="${newVehicle.name}"
                data-price="${newVehicle.price}"
                class="add-to-cart-btn w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-2.5 px-4 rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>🛒</span> Añadir
              </button>
            </div>
          `;

          if (productGrid) {
            productGrid.prepend(card);
          }

          form.reset();
          closeModal();
          filterProducts();
        });
      }
    });

    // Écouteur Clic Global Boutons "Añadir"
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.add-to-cart-btn');
      if (btn) {
        const vehicle = {
          id: Number(btn.getAttribute('data-id')),
          name: btn.getAttribute('data-name'),
          price: Number(btn.getAttribute('data-price'))
        };
        addToCart(vehicle);
      }
    });
  </script>

</body>
</html>
