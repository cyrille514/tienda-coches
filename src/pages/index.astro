---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Inicio - Tienda de Coches">
  <div class="overflow-hidden rounded-lg">
    <img 
      src="/vehiculos/showroom-coches.jpg" 
      alt="Showroom de Coches" 
      class="w-full h-[350px] object-cover"
    />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-5">
    <div class="overflow-hidden rounded-lg">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2993.250550505!2d2.155!3d41.391!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDHCsDIzJzI3LjYiTiAywrAwOScxOC4wIkU!5e0!3m2!1ses!2ses!4v1600000000000" 
        class="w-full h-[150px] border-0 rounded-lg" 
        allowfullscreen="" 
        loading="lazy">
      </iframe>
    </div>

    <div class="bg-white p-4 rounded-lg text-center flex flex-col justify-center items-center shadow-sm">
      <h4 class="font-bold text-blue-600 text-sm">SUSCRÍBETE A LA NEWSLETTER</h4>
      <p class="text-xs text-black font-bold mt-1 mb-3">Y llévate un ticket regalo para usar en nuestro showroom</p>
      <form class="w-full">
        <button type="submit" class="bg-black text-white px-5 py-2 rounded-md hover:bg-gray-800 transition-colors text-sm w-full sm:w-auto">
          Suscríbete ahora
        </button>
      </form>
    </div>
  </div>
</LayoutBase>


