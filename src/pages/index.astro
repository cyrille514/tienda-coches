---
// src/pages/index.astro
import LayoutBase from '../layouts/LayoutBase.astro';
import { BUCKET } from '../config';
---

<LayoutBase title="Inicio - Tienda de Coches | Exclusive Motors">
  <!-- Image principale Showroom Exclusivo -->
  <div class="relative w-full h-[460px] sm:h-[540px] lg:h-[600px] overflow-hidden rounded-3xl border border-slate-800/80 shadow-2xl group bg-slate-950 flex items-center justify-center">
    <img 
      src={`${BUCKET}showroom-coches.jpg`} 
      alt="Showroom de Coches" 
      class="w-full h-full object-cover object-[70%_center] group-hover:scale-105 transition-transform duration-700 ease-out"
      onerror="this.src='https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=1200&auto=format&fit=crop';"
    />
    <!-- Overlay dégradé et texte explicatif -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent flex items-end p-6 sm:p-10 pointer-events-none">
      <div class="max-w-xl pb-2">
        
        <h1 class="text-3xl sm:text-4xl font-extrabold text-violet-400 tracking-tight leading-tight">Showroom Exclusivo</h1>
        <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">Descubre nuestra selecta gama de vehículos de alta gama en un espacio diseñado para ti.</p>
      </div>
    </div>
  </div>
</LayoutBase>
