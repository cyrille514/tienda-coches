---
// src/pages/login.astro
import "../styles/global.css";
import LayoutBase from "../layouts/LayoutBase.astro";
// 1. SERVIDOR (Frontmatter: Corre en el servidor antes de enviar la página)
import { supabase } from '../lib/supabase';

// Leemos las cookies para saber si el usuario inició sesión
const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

let user = null;

if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  
  if (data.user) {
    user = data.user;
  }
  console.log('ID del usuario activo en servidor:', user?.id);
  
}
---
  <LayoutBase >
      <main style="padding: 2rem; font-family: sans-serif;">

      <h1>Bienvenido</h1>

      {user ? (
        <div>
          <p>Sesión iniciada con: <strong>{user.email}</strong></p>
          <p>Tu ID de Supabase es: <code>{user.id}</code></p>
          
          <form action="/api/auth/signout" method="POST">
            <button type="submit" class="bg-black text-white">
              Cerrar Sesión
            </button>
          </form>
        </div>
      ) : (
        <div>
          <p>No estás autenticado.</p>
          <button class="bg-black text-white" id="login-btn">Iniciar Sesión con Google</button>
        </div>
      )}

      </main>
  </LayoutBase>

<!-- 3. CLIENTE (JavaScript que corre en el navegador interactuando con el usuario) -->

<script>
  import { supabase } from '../lib/supabase';

  // Evento para iniciar sesión al pulsar el botón
  const loginBtn = document.getElementById('login-btn');
  loginBtn?.addEventListener('click', async () => {
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: `${window.location.origin}/login`,
      },
    });
  });

  // Guardar sesión en cookies para que el servidor (Astro) también la conozca
  supabase.auth.onAuthStateChange(async (event, session) => {
    if (session) {
      // Seteamos las cookies que el servidor de Astro está esperando
      const maxAge = 60 * 60 * 24 * 7; // 7 días
      document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${maxAge}; SameSite=Lax`;
      document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=${maxAge}; SameSite=Lax`;
    } else if (event === 'SIGNED_OUT') {
      // Borramos las cookies si cierra sesión
      document.cookie = 'sb-access-token=; path=/; max-age=0';
      document.cookie = 'sb-refresh-token=; path=/; max-age=0';
    }
  });

  // Imprimir el ID por la consola del navegador
  async function checkUser() {
    const { data: { user } } = await supabase.auth.getUser();
    if (user) {
      console.log('ID del usuario activo en cliente:', user.id);
    }
  }
  checkUser();
</script>
  
