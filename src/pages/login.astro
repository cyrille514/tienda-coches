---
// src/pages/login.astro
import "../styles/global.css";
import LayoutBase from "../layouts/LayoutBase.astro";
import { supabase } from '../lib/supabase';

// SERVIDOR: Leemos las cookies para saber si el usuario inició sesión
const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

let user = null;
if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  
  if (data.user) {
    user = data.user;
  }
}

// Si el usuario ya está conectado, lo redirigimos automáticamente al catálogo
if (user) {
  return Astro.redirect('/productos?categoria=1');
}
---

<LayoutBase>
  <main class="min-h-[70vh] flex items-center justify-center p-4">
    <div class="relative w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden p-8">
      
      <!-- VISTA 1: Google OAuth (Visible por defecto) -->
      <div id="google-login-section" class="flex flex-col items-center text-center w-full">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-800 mb-4">
          <svg class="w-6 h-6" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-1">Iniciar sesión</h2>
        <p class="text-xs text-slate-400 mb-6">Utiliza tu cuenta de Google</p>

        <button 
          id="login-btn"
          type="button"
          class="w-full flex items-center justify-center gap-3 bg-white hover:bg-slate-100 text-slate-800 font-semibold py-2.5 px-4 rounded-lg transition-colors shadow-md cursor-pointer text-sm mb-4"
        >
          Iniciar sesión con Google
        </button>

        <div class="text-xs text-slate-400 mt-2">
          ¿Primera vez por aquí? 
          <button id="crear-cuenta-btn" type="button" class="text-blue-400 font-semibold hover:underline cursor-pointer focus:outline-none ml-1">
            Crear cuenta
          </button>
        </div>
      </div>

      <!-- VISTA 2: Formulario de Registro (Oculto por defecto con 'hidden') -->
      <div id="registro-section" class="hidden flex-col w-full">
        <div class="flex items-center justify-between mb-4">
          <button type="button" id="back-to-login-btn" class="text-xs text-slate-400 hover:text-white flex items-center gap-1 cursor-pointer">
            ← Volver
          </button>
          <h3 class="text-sm font-semibold text-blue-400 leading-snug">Registro de nuevo cliente</h3>
        </div>

        <div class="mb-4">
          <h4 class="text-sm font-bold text-white leading-snug">Formulario de registro con los datos del nuevo cliente.</h4>
        </div>

        <form id="registro-form" class="space-y-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">Nombre y Apellidos</label>
            <input type="text" required class="w-full bg-slate-950 border border-slate-700 rounded-md p-2.5 text-xs text-white focus:outline-none focus:border-blue-500" placeholder="Ej. Carlos Gómez" />
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">Correo electrónico</label>
            <input type="email" required class="w-full bg-slate-950 border border-slate-700 rounded-md p-2.5 text-xs text-white focus:outline-none focus:border-blue-500" placeholder="correo@ejemplo.com" />
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">Contraseña</label>
            <input type="password" required class="w-full bg-slate-950 border border-slate-700 rounded-md p-2.5 text-xs text-white focus:outline-none focus:border-blue-500" placeholder="••••••••" />
          </div>

          <button type="submit" id="submit-reg-btn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition-colors mt-3 text-xs cursor-pointer shadow-lg shadow-blue-600/20">
            Registrarse
          </button>
        </form>
      </div>

    </div>
  </main>
</LayoutBase>

<script>
  import { supabase } from '../lib/supabase';

  const loginBtn = document.getElementById('login-btn');
  const crearCuentaBtn = document.getElementById('crear-cuenta-btn');
  const backToLoginBtn = document.getElementById('back-to-login-btn');
  const googleLoginSection = document.getElementById('google-login-section');
  const registroSection = document.getElementById('registro-section');
  const registroForm = document.getElementById('registro-form') as HTMLFormElement;
  const submitRegBtn = document.getElementById('submit-reg-btn') as HTMLButtonElement;

  // 1. Alternar a la vista de Registro al hacer clic en "Crear cuenta"
  crearCuentaBtn?.addEventListener('click', () => {
    googleLoginSection?.classList.remove('flex');
    googleLoginSection?.classList.add('hidden');
    registroSection?.classList.remove('hidden');
    registroSection?.classList.add('flex');
  });

  // 2. Volver a la vista de Google Login
  backToLoginBtn?.addEventListener('click', () => {
    registroSection?.classList.remove('flex');
    registroSection?.classList.add('hidden');
    googleLoginSection?.classList.remove('hidden');
    googleLoginSection?.classList.add('flex');
  });

  // 3. Conexión OAuth Google
  loginBtn?.addEventListener('click', async () => {
    loginBtn.textContent = 'Conectando...';
    (loginBtn as HTMLButtonElement).disabled = true;

    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: `${window.location.origin}/login`,
        queryParams: {
          prompt: 'select_account',
        },
      },
    });
  });

  // 4. Inscripción clásica (Email / Contraseña)
  registroForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const inputs = registroForm.querySelectorAll('input');
    const fullName = inputs[0].value;
    const email = inputs[1].value;
    const password = inputs[2].value;

    submitRegBtn.textContent = 'Creando cuenta...';
    submitRegBtn.disabled = true;

    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: {
        data: { full_name: fullName }
      }
    });

    if (error) {
      alert('Error al crear la cuenta: ' + error.message);
      submitRegBtn.textContent = 'Registrarse';
      submitRegBtn.disabled = false;
    } else {
      if (data.session) {
        const maxAge = 604800;
        document.cookie = `sb-access-token=${data.session.access_token}; path=/; max-age=${maxAge}; SameSite=Lax; Secure`;
        document.cookie = `sb-refresh-token=${data.session.refresh_token}; path=/; max-age=${maxAge}; SameSite=Lax; Secure`;
        window.location.href = '/productos?categoria=1';
      } else {
        alert('¡Cuenta creada con éxito! Revisa tu correo o inicia sesión.');
        window.location.reload();
      }
    }
  });

  // 5. Captura del token Google en la URL hash tras la redirección
  window.addEventListener('DOMContentLoaded', async () => {
    const hash = window.location.hash;
    if (hash && hash.includes('access_token')) {
      const params = new URLSearchParams(hash.substring(1));
      const access_token = params.get('access_token');
      const refresh_token = params.get('refresh_token');

      if (access_token && refresh_token) {
        await supabase.auth.setSession({
          access_token,
          refresh_token,
        });

        document.cookie = 'sb-access-token=; path=/; max-age=0;';
        document.cookie = 'sb-refresh-token=; path=/; max-age=0;';

        const maxAge = 604800;
        document.cookie = `sb-access-token=${access_token}; path=/; max-age=${maxAge}; SameSite=Lax; Secure`;
        document.cookie = `sb-refresh-token=${refresh_token}; path=/; max-age=604800; SameSite=Lax; Secure`;

        window.location.href = '/productos?categoria=1';
      }
    }
  });

  // 6. Gestión de cambios de estado de sesión
  supabase.auth.onAuthStateChange(async (event, session) => {
    if (session) {
      const maxAge = 604800;
      document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${maxAge}; SameSite=Lax; Secure`;
      document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=${maxAge}; SameSite=Lax; Secure`;
    } else if (event === 'SIGNED_OUT') {
      document.cookie = 'sb-access-token=; path=/; max-age=0';
      document.cookie = 'sb-refresh-token=; path=/; max-age=0';
    }
  });
</script>
