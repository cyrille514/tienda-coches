---
// src/pages/login.astro
import "../styles/global.css";
import LayoutBase from "../layouts/LayoutBase.astro";
import { supabase } from '../lib/supabase';

// SERVIDOR: Leemos las cookies para saber si el usuario inició sesión
const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

let user = null;
if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  
  if (data.user) {
    user = data.user;
  }
  console.log('ID del usuario activo en servidor:', user?.id);
}
---

<LayoutBase>
  <main class="min-h-[80vh] flex items-center justify-center p-4 bg-slate-950">
    <div class="relative w-full max-w-4xl bg-slate-900 border border-gray-800 rounded-xl shadow-2xl overflow-hidden">
      
      {user ? (
        <!-- VISTA DE USUARIO AUTENTICADO -->
        <div class="p-8 text-center text-white space-y-4">
          <h1 class="text-3xl font-bold text-emerald-400">¡Bienvenido!</h1>
          <p class="text-gray-300">Sesión iniciada con: <strong>{user.email}</strong></p>
          <p class="text-sm text-gray-400">Tu ID de Supabase es: <code class="bg-slate-800 px-2 py-1 rounded text-emerald-300">{user.id}</code></p>
          
          <form action="/api/auth/signout" method="POST" class="pt-4">
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-6 rounded-lg transition-colors cursor-pointer">
              Cerrar Sesión
            </button>
          </form>
        </div>
      ) : (
        <!-- VISTA DE LOGIN Y REGISTRO (DOS COLUMNAS) -->
        <div class="flex flex-col md:flex-row w-full min-h-[480px]">
          
          <!-- COLUMNA IZQUIERDA: Google OAuth -->
          <div class="w-full md:w-1/2 p-8 flex flex-col justify-center items-center border-b md:border-b-0 md:border-r border-gray-800">
            <div class="mb-6 text-center">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-800 mb-4">
                <svg class="w-6 h-6" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-white">Iniciar sesión</h2>
              <p class="text-sm text-gray-400 mt-1">Utiliza tu cuenta de Google</p>
            </div>

            <button 
              id="login-btn"
              class="w-full flex items-center justify-center gap-3 bg-white hover:bg-gray-100 text-gray-800 font-semibold py-2.5 px-4 rounded-lg transition-colors shadow-md cursor-pointer"
            >
              Iniciar sesión con Google
            </button>

            <div class="mt-8 text-xs text-left w-full text-gray-400">
              <span class="text-blue-400 font-semibold">Crear cuenta</span> (Primera vez)
            </div>
          </div>

          <!-- COLUMNA DERECHA: Formulario de Registro -->
          <div class="w-full md:w-1/2 p-8 bg-slate-900/60 flex flex-col justify-center">
            <h3 class="text-lg font-semibold text-blue-400 mb-4">
              Formulario de registro con los datos del nuevo cliente
            </h3>

            <form class="space-y-3">
              <div>
                <label class="block text-xs text-gray-400 mb-1">Nombre y Apellidos</label>
                <input type="text" required class="w-full bg-slate-950 border border-gray-700 rounded-md p-2.5 text-sm text-white focus:outline-none focus:border-blue-500" placeholder="Ej. Carlos Gómez" />
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1">Correo electrónico o teléfono</label>
                <input type="email" required class="w-full bg-slate-950 border border-gray-700 rounded-md p-2.5 text-sm text-white focus:outline-none focus:border-blue-500" placeholder="correo@ejemplo.com" />
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1">Contraseña</label>
                <input type="password" required class="w-full bg-slate-950 border border-gray-700 rounded-md p-2.5 text-sm text-white focus:outline-none focus:border-blue-500" placeholder="••••••••" />
              </div>
              
              <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg transition-colors mt-2 cursor-pointer">
                Siguiente
              </button>
            </form>
          </div>

        </div>
      )}

    </div>
  </main>
</LayoutBase>

<!-- CLIENTE (JavaScript del profesor) -->
<script>
  import { supabase } from '../lib/supabase';

  // Evento para iniciar sesión al pulsar el botón
  const loginBtn = document.getElementById('login-btn');
  loginBtn?.addEventListener('click', async () => {
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: `${window.location.origin}/login`,
      },
    });
  });

  // Guardar sesión en cookies para que el servidor (Astro) también la conozca
  supabase.auth.onAuthStateChange(async (event, session) => {
    if (session) {
      // Seteamos las cookies que el servidor de Astro está esperando
      const maxAge = 60 * 60 * 24 * 7; // 7 días
      document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${maxAge}; SameSite=Lax`;
      document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=${maxAge}; SameSite=Lax`;
    } else if (event === 'SIGNED_OUT') {
      // Borramos las cookies si cierra sesión
      document.cookie = 'sb-access-token=; path=/; max-age=0';
      document.cookie = 'sb-refresh-token=; path=/; max-age=0';
    }
  });

  // Imprimir el ID por la consola del navegador
  async function checkUser() {
    const { data: { user } } = await supabase.auth.getUser();
    if (user) {
      console.log('ID del usuario activo en cliente:', user.id);
    }
  }
  checkUser();
</script>

