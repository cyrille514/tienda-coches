---
// src/pages/producto/[id].astro
import LayoutBase from '@/layouts/LayoutBase.astro';
import { supabase } from '@/lib/supabase';

const { id } = Astro.params;

const { data: producto, error } = await supabase
  .from('productos')
  .select('*')
  .eq('pk_producto', id)
  .maybeSingle();

if (error || !producto) {
  return Astro.redirect('/productos?categoria=1');
}

const precioBase = Number(producto.precio || 0);
// Correction de la formule de calcul avec la multiplication (*) et suppression du tiret parasite
const precioConIva = (precioBase * 1.21).toFixed(2);
const nombreProducto = producto.nombre_producto || producto.nom_producto || 'Vehículo';
---

<LayoutBase title={`${nombreProducto} | Tienda de Coches`} categoriaActivaId={producto.fk_categoria}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    
    <div class="mb-6">
      <button 
        onclick="window.history.back()" 
        class="inline-flex items-center gap-2 px-3.5 py-2 bg-slate-900 text-slate-200 hover:bg-slate-800 border border-slate-700 rounded-xl text-sm font-semibold transition-colors cursor-pointer shadow-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Volver
      </button>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 p-6 sm:p-10 rounded-2xl shadow-xl grid grid-cols-1 md:grid-cols-2 gap-8 items-center text-white">
      
      <div class="flex justify-center items-center bg-slate-950 p-6 rounded-xl border border-slate-800/80 min-h-[260px]">
        <img 
          src={producto.url_imagen || producto.imagen || '/placeholder.jpg'} 
          alt={nombreProducto} 
          class="max-h-72 w-auto object-contain rounded-lg"
        />
      </div>

      <div class="flex flex-col justify-center space-y-4 text-center md:text-left">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">{nombreProducto}</h1>
        
        <p class="text-xs sm:text-sm text-slate-300 font-medium">
          Color: {producto.color || 'plata'} {producto.tamano ? `| ${producto.tamano}` : ''}
        </p>
        <p class="text-xs text-slate-400">
          Referencia: {producto.referencia || `GRP_${producto.pk_producto}03029`}
        </p>

        <div class="pt-2">
          <span class="text-3xl font-black text-blue-400">
            {Number(precioConIva).toLocaleString('es-ES', { minimumFractionDigits: 2 })} €
          </span>
          <p class="text-xs text-slate-400 font-medium mt-1">21% IVA incluido</p>
        </div>

        <div class="flex items-center justify-center md:justify-start gap-3 pt-4">
          <span class="text-xs sm:text-sm font-bold text-slate-300">Cantidad:</span>
          <div class="flex items-center bg-slate-950 border border-slate-700 rounded-xl overflow-hidden">
            <button id="btn-minus" type="button" class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 font-bold text-white transition-colors cursor-pointer">-</button>
            <span id="cantidad-val" class="px-4 py-1.5 font-bold text-white text-sm">1</span>
            <button id="btn-plus" type="button" class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 font-bold text-white transition-colors cursor-pointer">+</button>
          </div>
        </div>

        <div class="pt-4">
          <button 
            id="btn-add-cart"
            type="button"
            class="w-full md:w-auto bg-blue-600 hover:bg-blue-500 active:scale-95 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg transition-all cursor-pointer text-sm flex items-center justify-center gap-2"
          >
            Añadir a la cesta
          </button>
        </div>
      </div>

    </div>
  </div>
</LayoutBase>

<script define:vars={{ producto, precioConIva }}>
  let cantidad = 1;
  const cantSpan = document.getElementById('cantidad-val');
  const btnMinus = document.getElementById('btn-minus');
  const btnPlus = document.getElementById('btn-plus');
  const btnAdd = document.getElementById('btn-add-cart');

  btnMinus?.addEventListener('click', () => {
    if (cantidad > 1) {
      cantidad--;
      if (cantSpan) cantSpan.textContent = cantidad.toString();
    }
  });

  btnPlus?.addEventListener('click', () => {
    cantidad++;
    if (cantSpan) cantSpan.textContent = cantidad.toString();
  });

  btnAdd?.addEventListener('click', () => {
    const cestaPrevias = localStorage.getItem("cesta");
    let cesta = cestaPrevias ? JSON.parse(cestaPrevias) : [];

    const existingIndex = cesta.findIndex(item => item.pk_producto === producto.pk_producto);

    if (existingIndex > -1) {
      cesta[existingIndex].cantidad += cantidad;
    } else {
      cesta.push({
        pk_producto: producto.pk_producto,
        nombre_producto: producto.nombre_producto || producto.nom_producto || 'Vehículo',
        precio: Number(precioConIva),
        url_imagen: producto.url_imagen || producto.imagen,
        referencia: producto.referencia || `GRP_${producto.pk_producto}03029`,
        color: producto.color || 'plata',
        cantidad: cantidad
      });
    }

    // Sauvegarde normalisée sous la clé 'cesta'
    localStorage.setItem("cesta", JSON.stringify(cesta));

    // Déclenchement de l'événement pour mettre à jour les badges globaux
    window.dispatchEvent(new Event("cestaUpdated"));

    const textoOriginal = btnAdd.textContent;
    btnAdd.textContent = "✓ Añadido a la cesta";
    btnAdd.classList.add("bg-emerald-600");
    btnAdd.classList.remove("bg-blue-600");

    setTimeout(() => {
      btnAdd.textContent = textoOriginal;
      btnAdd.classList.remove("bg-emerald-600");
      btnAdd.classList.add("bg-blue-600");
    }, 1200);
  });
</script>
