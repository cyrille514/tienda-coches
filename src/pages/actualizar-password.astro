---
// src/pages/actualizar-password.astro
---
<html lang="es" class="bg-zinc-950 text-zinc-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nueva Contraseña - Tienda Coches</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex items-center justify-center p-4 font-sans">

  <main class="max-w-md w-full bg-zinc-900 border border-zinc-800 p-8 rounded-2xl shadow-2xl">
    <div class="mb-6">
      <div class="w-10 h-10 rounded-xl bg-zinc-100 text-zinc-950 flex items-center justify-center font-bold text-sm tracking-tighter mb-4">
        TC
      </div>
      <h1 class="text-xl font-bold text-white">Crear nueva contraseña</h1>
      <p class="text-xs text-zinc-400 mt-1">Introduce tu nueva contraseña para recuperar el acceso a tu cuenta.</p>
    </div>

    <form id="update-password-form" class="space-y-4">
      <div class="space-y-1.5">
        <label class="block text-xs font-medium text-zinc-300">Nueva contraseña</label>
        <input type="password" id="new-password" required minlength="6" class="w-full h-10 bg-zinc-950 border border-zinc-800 rounded-lg px-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors" placeholder="Mínimo 6 caracteres" />
      </div>
      <div class="space-y-1.5">
        <label class="block text-xs font-medium text-zinc-300">Confirmar contraseña</label>
        <input type="password" id="confirm-password" required minlength="6" class="w-full h-10 bg-zinc-950 border border-zinc-800 rounded-lg px-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors" placeholder="Repite la contraseña" />
      </div>
      <button type="submit" id="save-password-btn" class="w-full h-10 bg-zinc-100 hover:bg-white text-zinc-950 font-semibold rounded-lg transition-colors text-xs cursor-pointer shadow-sm mt-2">
        Guardar nueva contraseña
      </button>
    </form>
  </main>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('update-password-form') as HTMLFormElement;
    const saveBtn = document.getElementById('save-password-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

      if (newPassword !== confirmPassword) {
        alert('Las contraseñas no coinciden.');
        return;
      }

      saveBtn.textContent = 'Actualizando...';
      saveBtn.disabled = true;

      const { error } = await supabase.auth.updateUser({
        password: newPassword
      });

      if (error) {
        alert('Error al actualizar la contraseña: ' + error.message);
        saveBtn.textContent = 'Guardar nueva contraseña';
        saveBtn.disabled = false;
      } else {
        alert('¡Contraseña actualizada con éxito! Ya puedes iniciar sesión.');
        window.location.href = '/';
      }
    });
  </script>

</body>
</html>
