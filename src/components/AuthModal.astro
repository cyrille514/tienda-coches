---
// src/components/AuthModal.astro
---
<dialog id="auth-modal" class="p-0 rounded-2xl shadow-2xl backdrop:bg-zinc-950/80 backdrop-blur-sm border border-zinc-800 max-w-md w-full bg-zinc-900 text-zinc-100 overflow-hidden m-auto">
  <div class="relative flex flex-col w-full p-6 sm:p-8">
    
    <!-- Bouton de fermeture -->
    <button id="close-modal-btn" type="button" class="absolute top-4 right-4 text-zinc-400 hover:text-zinc-100 text-lg font-bold z-20 cursor-pointer p-1 rounded-lg hover:bg-zinc-800 transition-colors">
      ✕
    </button>

    <!-- VUE 1 : CONNEXION (Google + Email/Mot de passe) -->
    <div id="google-login-view" class="flex flex-col items-center text-center w-full">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-800 border border-zinc-700/60 mb-4 shadow-sm">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
      </div>
      <h2 class="text-xl font-semibold tracking-tight text-white mb-1">Identifícate</h2>
      <p class="text-xs text-zinc-400 mb-5">Accede con Google o con tu correo electrónico</p>

      <button id="modal-google-btn" type="button" class="w-full h-11 flex items-center justify-center gap-3 bg-zinc-100 hover:bg-white text-zinc-950 font-semibold px-4 rounded-lg transition-colors shadow-sm cursor-pointer text-xs mb-4">
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Continuar con Google</span>
      </button>

      <!-- Séparateur -->
      <div class="relative w-full flex items-center justify-center my-2">
        <div class="border-t border-zinc-800 w-full"></div>
        <span class="bg-zinc-900 px-3 text-[11px] uppercase tracking-wider text-zinc-500">o con correo</span>
        <div class="border-t border-zinc-800 w-full"></div>
      </div>

      <!-- Formulaire Connexion Email / Mot de passe -->
      <form id="login-email-form" class="w-full space-y-3 text-left mt-2 mb-4">
        <div class="space-y-1">
          <label class="block text-xs font-medium text-zinc-300">Correo electrónico</label>
          <input type="email" id="login-email" required class="w-full h-10 bg-zinc-950 border border-zinc-800 rounded-lg px-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors" placeholder="correo@ejemplo.com" />
        </div>
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-medium text-zinc-300">Contraseña</label>
            <button type="button" id="go-to-forgot-btn" class="text-[11px] text-zinc-400 hover:text-zinc-100 hover:underline cursor-pointer bg-transparent border-none p-0">
              ¿Olvidaste tu contraseña?
            </button>
          </div>
          <input type="password" id="login-password" required class="w-full h-10 bg-zinc-950 border border-zinc-800 rounded-lg px-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors" placeholder="••••••••" />
        </div>
        <button type="submit" id="submit-login-btn" class="w-full h-10 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-semibold rounded-lg transition-colors text-xs cursor-pointer border border-zinc-700">
          Iniciar Sesión
        </button>
      </form>

      <div class="text-xs text-zinc-400">
        ¿Primera vez por aquí? 
        <button type="button" id="go-to-register-btn" class="text-zinc-200 font-semibold hover:underline bg-transparent border-none p-0 cursor-pointer ml-1">
          Crear cuenta
        </button>
      </div>
    </div>

    <!-- VUE 2 : FORMULAIRE D'INSCRIPTION -->
    <div id="register-view" class="hidden flex-col w-full">
      <div class="flex items-center justify-between mb-4">
        <button type="button" class="back-to-login-btn text-xs text-zinc-400 hover:text-zinc-100 flex items-center gap-1 cursor-pointer transition-colors">
          ← Volver
        </button>
        <h3 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider">Nuevo Cliente</h3>
      </div>

      <div class="mb-4 space-y-1">
        <h4 class="text-sm font-semibold text-white">Registro en el sistema</h4>
        <p class="text-xs text-zinc-400">Rellena tus datos para dar de alta tu cuenta profesional.</p>
      </div>

      <form id="registro-form" class="space-y-3.5">
        <div class="space-y-1.5">
          <label class="block text-xs font-medium text-zinc-300">Nombre y Apellidos</label>
          <input type="text" id="reg-nombre" name="nombre" required class="w-full h-10 bg-zinc-950 border border-zinc-800 rounded-lg px-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors" placeholder="Ej. Carlos Gómez" />
        </div>
        <div class="space-y-1.5">
          <label class="block text-xs font-medium text-zinc-300">Correo electrónico</label>
          <input type="email" id="reg-email" name="email" required class="w-full h-10 bg-zinc-950 border border-zinc-800 rounded-lg px-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors" placeholder="correo@ejemplo.com" />
        </div>
        <div class="space-y-1.5">
          <label class="block text-xs font-medium text-zinc-300">Contraseña</label>
          <input type="password" id="reg-password" name="password" required minlength="6" class="w-full h-10 bg-zinc-950 border border-zinc-800 rounded-lg px-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors" placeholder="Mínimo 6 caracteres" />
        </div>
        <button type="submit" id="submit-reg-btn" class="w-full h-10 bg-zinc-100 hover:bg-white text-zinc-950 font-semibold rounded-lg transition-colors mt-2 text-xs cursor-pointer shadow-sm">
          Registrarse
        </button>
      </form>
    </div>

    <!-- VUE 3 : RÉCUPÉRATION DU MOT DE PASSE -->
    <div id="forgot-password-view" class="hidden flex-col w-full">
      <div class="flex items-center justify-between mb-4">
        <button type="button" class="back-to-login-btn text-xs text-zinc-400 hover:text-zinc-100 flex items-center gap-1 cursor-pointer transition-colors">
          ← Volver
        </button>
        <h3 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider">Recuperación</h3>
      </div>

      <div class="mb-4 space-y-1">
        <h4 class="text-sm font-semibold text-white">Restablecer contraseña</h4>
        <p class="text-xs text-zinc-400">Introduce tu correo electrónico y te enviaremos un enlace seguro para crear una nueva contraseña.</p>
      </div>

      <form id="forgot-password-form" class="space-y-4">
        <div class="space-y-1.5">
          <label class="block text-xs font-medium text-zinc-300">Correo electrónico registrado</label>
          <input type="email" id="forgot-email" required class="w-full h-10 bg-zinc-950 border border-zinc-800 rounded-lg px-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:border-zinc-500 transition-colors" placeholder="correo@ejemplo.com" />
        </div>
        <button type="submit" id="submit-forgot-btn" class="w-full h-10 bg-zinc-100 hover:bg-white text-zinc-950 font-semibold rounded-lg transition-colors text-xs cursor-pointer shadow-sm">
          Enviar enlace de recuperación
        </button>
      </form>
    </div>

  </div>
</dialog>

<script>
  import { supabase } from '../lib/supabase';

  const modal = document.getElementById('auth-modal') as HTMLDialogElement;
  const userBtn = document.getElementById('open-auth-modal') || document.getElementById('user-icon-btn');
  const closeBtn = document.getElementById('close-modal-btn');
  const googleBtn = document.getElementById('modal-google-btn') as HTMLButtonElement;
  
  const loginEmailForm = document.getElementById('login-email-form') as HTMLFormElement;
  const submitLoginBtn = document.getElementById('submit-login-btn') as HTMLButtonElement;
  const registroForm = document.getElementById('registro-form') as HTMLFormElement;
  const submitRegBtn = document.getElementById('submit-reg-btn') as HTMLButtonElement;
  const forgotForm = document.getElementById('forgot-password-form') as HTMLFormElement;
  const submitForgotBtn = document.getElementById('submit-forgot-btn') as HTMLButtonElement;
  
  const goToRegisterBtn = document.getElementById('go-to-register-btn');
  const goToForgotBtn = document.getElementById('go-to-forgot-btn');
  const backToLoginBtns = document.querySelectorAll('.back-to-login-btn');
  
  const googleLoginView = document.getElementById('google-login-view');
  const registerView = document.getElementById('register-view');
  const forgotView = document.getElementById('forgot-password-view');

  function showView(viewToShow: HTMLElement | null) {
    [googleLoginView, registerView, forgotView].forEach(view => {
      if (view === viewToShow) {
        view?.classList.remove('hidden');
        view?.classList.add('flex');
      } else {
        view?.classList.remove('flex');
        view?.classList.add('hidden');
      }
    });
  }

  userBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    showView(googleLoginView);
    modal?.showModal();
  });

  closeBtn?.addEventListener('click', () => modal?.close());

  modal?.addEventListener('click', (e) => {
    const dim = modal.getBoundingClientRect();
    if (e.clientX < dim.left || e.clientX > dim.right || e.clientY < dim.top || e.clientY > dim.bottom) {
      modal.close();
    }
  });

  goToRegisterBtn?.addEventListener('click', () => showView(registerView));
  goToForgotBtn?.addEventListener('click', () => showView(forgotView));
  backToLoginBtns.forEach(btn => btn.addEventListener('click', () => showView(googleLoginView)));

  // Connexion Google OAuth
  googleBtn?.addEventListener('click', async () => {
    if (!googleBtn) return;
    googleBtn.textContent = 'Conectando...';
    googleBtn.disabled = true;
    
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: window.location.origin }
    });

    if (error) {
      alert('Error al conectar con Google: ' + error.message);
      googleBtn.textContent = 'Continuar con Google';
      googleBtn.disabled = false;
    }
  });

  // Connexion par Email et Mot de passe
  loginEmailForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = document.getElementById('login-email') as HTMLInputElement;
    const passwordInput = document.getElementById('login-password') as HTMLInputElement;
    if (!emailInput || !passwordInput || !submitLoginBtn) return;

    submitLoginBtn.textContent = 'Iniciando sesión...';
    submitLoginBtn.disabled = true;

    const { error } = await supabase.auth.signInWithPassword({
      email: emailInput.value,
      password: passwordInput.value,
    });

    if (error) {
      alert('Credenciales incorrectas: ' + error.message);
      submitLoginBtn.textContent = 'Iniciar Sesión';
      submitLoginBtn.disabled = false;
    } else {
      window.location.reload();
    }
  });

  // Inscription
  registroForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = document.getElementById('reg-email') as HTMLInputElement;
    const passwordInput = document.getElementById('reg-password') as HTMLInputElement;
    if (!emailInput || !passwordInput || !submitRegBtn) return;

    submitRegBtn.textContent = 'Registrando...';
    submitRegBtn.disabled = true;

    const { error } = await supabase.auth.signUp({
      email: emailInput.value,
      password: passwordInput.value,
    });

    if (error) {
      alert('Error en el registro: ' + error.message);
      submitRegBtn.textContent = 'Registrarse';
      submitRegBtn.disabled = false;
    } else {
      alert('¡Registro exitoso! Revisa tu correo para verificar tu cuenta.');
      modal?.close();
      registroForm.reset();
      submitRegBtn.textContent = 'Registrarse';
      submitRegBtn.disabled = false;
    }
  });

  // Envoi de l'e-mail de récupération de mot de passe
  forgotForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = document.getElementById('forgot-email') as HTMLInputElement;
    if (!emailInput || !submitForgotBtn) return;

    submitForgotBtn.textContent = 'Enviando enlace...';
    submitForgotBtn.disabled = true;

    const { error } = await supabase.auth.resetPasswordForEmail(emailInput.value, {
      redirectTo: `${window.location.origin}/actualizar-password`,
    });

    if (error) {
      alert('Error al enviar el correo: ' + error.message);
    } else {
      alert('¡Correo enviado! Revisa tu bandeja de entrada para restablecer tu contraseña.');
      forgotForm.reset();
      showView(googleLoginView);
    }

    submitForgotBtn.textContent = 'Enviar enlace de recuperación';
    submitForgotBtn.disabled = false;
  });
</script>
