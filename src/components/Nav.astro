---
// src/components/Nav.astro
import { supabase } from '@/lib/supabase';

const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

let userEmail = null;
if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  if (data.user) userEmail = data.user.email;
}
---

<header class="sticky top-0 z-40 w-full bg-zinc-950/85 backdrop-blur-md border-b border-zinc-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    
    <!-- Marca -->
    <a href="/" class="flex items-center gap-2.5 shrink-0 group">
      <div class="w-8 h-8 rounded-lg bg-violet-400 text-black flex items-center justify-center font-bold text-sm tracking-tighter group-hover:bg-white transition-colors">
        TC
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-tight text-violet-500 leading-none">
          TIENDACOCHES
        </span>
        <span class="text-[10px] font-medium tracking-widest text-green-300 uppercase mt-0.5">
          Showroom
        </span>
      </div>
    </a>

    <!-- [SUPPRIMÉ] Les liens de navigation (Catálogo, Concesionario, Club Privado) ont été retirés d'ici -->

    <!-- Acciones de Usuario y Carrito -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      {userEmail ? (
        <a 
          href="/perfil" 
          class="h-10 px-3 sm:px-4 rounded-lg border border-zinc-800 bg-zinc-900/60 hover:bg-zinc-800 text-xs sm:text-sm font-medium text-zinc-200 flex items-center gap-2 transition-colors max-w-[140px] sm:max-w-[200px]"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
          <span class="truncate">{userEmail}</span>
        </a>
      ) : (
        <button 
          id="open-auth-modal"
          class="h-10 px-3.5 sm:px-4 rounded-lg border border-zinc-800 bg-white hover:bg-violet-400 hover:border-zinc-700 text-xs sm:text-sm font-medium text-zinc-200 flex items-center gap-2 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 text-violet-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
          <span>Identifícate</span>
        </button>
      )}

      <a 
        href="/carrito" 
        class="h-10 px-3.5 sm:px-4 rounded-lg bg-violet-400 hover:bg-white text-zinc-950 text-xs sm:text-sm font-semibold flex items-center gap-2 transition-all shadow-sm relative"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
        </svg>
        <span class="hidden sm:inline">Carrito</span>
        <!-- Badge dynamique du panier -->
        <span id="cart-badge" class="absolute -top-1.5 -right-1.5 bg-red-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full shadow-md hidden">
          0
        </span>
      </a>
    </div>

  </div>
</header>

<script>
  import { supabase } from '@/lib/supabase';

  // 1. Intercepte le retour Google OAuth UNE SEULE FOIS pour éviter les boucles infinies
  supabase.auth.onAuthStateChange(async (event, session) => {
    if ((event === 'SIGNED_IN' || event === 'TOKEN_REFRESHED') && session) {
      const hasCookie = document.cookie.includes('sb-access-token');
      
      if (!hasCookie) {
        document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=31536000; SameSite=Lax`;
        document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=31536000; SameSite=Lax`;
        window.location.href = window.location.pathname;
      }
    }
  });

  // 2. Mise à jour dynamique du compteur du panier
  function updateNavCartCount() {
    const badge = document.getElementById('cart-badge');
    if (!badge) return;

    try {
      const rawCesta = localStorage.getItem("cesta") || localStorage.getItem("tienda_coches_carrito") || "[]";
      const parsed = JSON.parse(rawCesta);
      const cesta = Array.isArray(parsed[0]) ? parsed[0] : parsed;
      
      const totalItems = Array.isArray(cesta) 
        ? cesta.reduce((acc, item) => acc + Number(item.cantidad || 1), 0) 
        : 0;

      if (totalItems > 0) {
        badge.textContent = totalItems.toString();
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    } catch (e) {
      badge.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', updateNavCartCount);
  window.addEventListener('cestaUpdated', updateNavCartCount);
  updateNavCartCount();
</script>
