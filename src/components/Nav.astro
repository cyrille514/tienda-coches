---
// src/components/Nav.astro
import { supabase } from '@/lib/supabase';

const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

let nombreUsuario = null;

if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });

  if (data.user) {
    nombreUsuario = 
      data.user.user_metadata?.full_name || 
      data.user.user_metadata?.nombre || 
      data.user.email;
  }
}

// Fonction pour raccourcir le nom s'il est trop long pour l'affichage
const formatNombre = (nombre: string) => {
  if (!nombre) return '';
  if (nombre.includes('@')) return nombre.split('@')[0];
  return nombre.length > 12 ? nombre.substring(0, 10) + '...' : nombre;
};

const textoUsuario = nombreUsuario ? `Hola, ${formatNombre(nombreUsuario)}` : 'Identifícate';
---

<header class="sticky top-0 z-50 glass-panel border-b border-slate-800/80 bg-slate-950/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    
    <!-- Logo & Marque -->
    <a href="/productos?categoria=1" class="flex items-center gap-3 group shrink-0">
      <div>
        <span class="text-lg sm:text-xl font-extrabold tracking-tight text-white block leading-none">
          TIENDA<span class="text-blue-500">COCHES</span>
        </span>
        <span class="text-[9px] sm:text-[10px] tracking-widest text-slate-400 uppercase font-semibold block mt-0.5">Showroom Automóvil</span>
      </div>
    </a>

    <!-- Actions de droite -->
    <div class="flex items-center gap-2 sm:gap-3">
      
      <!-- Utilisateur / Connexion -->
      <a href={nombreUsuario ? "/perfil" : "/login"}
         class="hidden md:flex items-center gap-2 px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-900 transition-colors text-xs sm:text-sm font-medium border border-slate-800">
        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="truncate max-w-[130px]">{textoUsuario}</span>
      </a>

      <!-- Bouton Panier avec Badge Dynamique -->
      <div class="relative shrink-0">
        <a href="/carrito" class="relative flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 transition-all group" aria-label="Ver Cesta">
          <svg class="w-5 h-5 text-blue-400 transition-transform group-hover:scale-110 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="font-semibold text-xs sm:text-sm hidden sm:inline">Carrito</span>
          
          <span 
            id="cart-badge"
            class="absolute -top-1.5 -right-1.5 bg-red-600 text-white text-[10px] font-bold rounded-full h-5 w-5 flex items-center justify-center shadow-md hidden"
          >
            0
          </span>
        </a>
      </div>

      <!-- Bouton Profil -->
      <a href="/perfil" class="px-3.5 py-2 text-xs sm:text-sm rounded-xl font-semibold text-white bg-blue-600 hover:bg-blue-700 transition-all shadow-sm shadow-blue-500/20 shrink-0">
        Perfil
      </a>

      <!-- Bouton Déconnexion -->
      {nombreUsuario && (
        <a href="/api/auth/signout" class="px-3 py-2 text-xs rounded-xl font-medium text-red-400 bg-red-950/40 hover:bg-red-900/50 border border-red-900/50 transition-colors shrink-0" title="Cerrar sesión">
          Salir
        </a>
      )}
    </div>
  </div>
</header>

<script>
  const updateCartBadge = () => {
    const badge = document.getElementById("cart-badge");
    if (!badge) return;

    try {
      const rawCesta = localStorage.getItem("cesta") || localStorage.getItem("tienda_coches_carrito") || "[]";
      const cesta = JSON.parse(rawCesta);
      const totalItems = cesta.reduce((acc, item) => acc + (item.cantidad || 1), 0);

      if (totalItems > 0) {
        badge.textContent = totalItems.toString();
        badge.classList.remove("hidden");
      } else {
        badge.classList.add("hidden");
      }
    } catch (error) {
      console.error("Error al actualizar el badge:", error);
    }
  };

  document.addEventListener("DOMContentLoaded", updateCartBadge);
  window.addEventListener("cestaUpdated", updateCartBadge);
  window.addEventListener("storage", updateCartBadge);
</script>
