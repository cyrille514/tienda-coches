---
interface Props {
  vehiculo: {
    pk_producto: number;
    nombre_producto: string;
    precio: number;
    descripcion_producto?: string;
    url_imagen?: string;
  };
}

const { vehiculo } = Astro.props;
---

<div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden shadow-lg flex flex-col justify-between">
  {vehiculo.url_imagen ? (
    <img 
      src={vehiculo.url_imagen} 
      alt={vehiculo.nombre_producto} 
      class="w-full h-48 object-cover"
    />
  ) : (
    <div class="w-full h-48 bg-slate-700 flex items-center justify-center text-slate-400">
      Sin imagen
    </div>
  )}

  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-xl font-bold mb-2 text-white">{vehiculo.nombre_producto}</h3>
      {vehiculo.descripcion_producto && (
        <p class="text-slate-400 text-sm mb-4 line-clamp-2">{vehiculo.descripcion_producto}</p>
      )}
    </div>
    <div class="flex justify-between items-center mt-4 pt-4 border-t border-slate-700">
      <span class="text-2xl font-extrabold text-green-400">{vehiculo.precio} €</span>
      
      <!-- REDIRECCIÓN A LA VISTA DEDICADA DE PRODUCTO -->
      <a 
        href={`/producto/${vehiculo.pk_producto}`} 
        class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg text-sm transition"
      >
        Ver detalles
      </a>
    </div>
  </div>
</div>
