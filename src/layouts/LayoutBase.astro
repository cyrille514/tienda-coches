---
// src/layouts/LayoutBase.astro
import '@/styles/global.css';
import MenuCategorias from '@/components/MenuCategorias.astro';
import Nav from '@/components/Nav.astro';
import AuthModal from '@/components/AuthModal.astro';
import { supabase } from '@/lib/supabase';

interface Props {
  title?: string;
  categoriaActivaId?: number;
}

const { title = "Tienda de Coches | Exclusive Motors", categoriaActivaId } = Astro.props;

const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

let user = null;
if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  if (data.user) user = data.user;
}
---

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased">

  <Nav />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 w-full flex-1">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
      
      <!-- SIDEBAR GAUCHE : Catégories + Dónde estamos + Newsletter -->
      <aside class="lg:col-span-3 space-y-4">
        
        <!-- Menu Catégories -->
        <div class="glass-panel p-4 rounded-3xl shadow-xl border border-slate-800/80">
          <MenuCategorias categoriaActivaId={categoriaActivaId} />
        </div>

        <!-- Dónde Estamos & Carte -->
        <div class="bg-slate-900/90 backdrop-blur-md p-3.5 rounded-2xl border border-slate-800/80 shadow-lg space-y-2">
          <div class="flex items-center gap-1.5 text-emerald-400 text-[10px] font-bold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Dónde Estamos
          </div>
          <p class="text-[11px] text-slate-300 leading-relaxed">
            Calle Balmes 114, Barcelona.
          </p>
          <div class="w-full h-[80px] rounded-xl overflow-hidden border border-slate-800 shadow-inner">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2993.250550505!2d2.155!3d41.391!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDHCsDIzJzI3LjYiTiAywrAwOScxOC4wIkU!5e0!3m2!1ses!2ses!4v1600000000000" 
              class="w-full h-full border-0 filter contrast-125 invert hue-rotate-180" 
              allowfullscreen="" 
              loading="lazy">
            </iframe>
          </div>
        </div>

        <!-- Newsletter Exclusiva -->
        <div class="bg-gradient-to-br from-slate-900/90 to-slate-950/90 backdrop-blur-md p-3.5 rounded-2xl border border-slate-800/80 shadow-lg text-center">
          <h4 class="font-bold text-blue-400 text-[10px] tracking-wider uppercase mb-1">Newsletter</h4>
          <p class="text-[10px] text-slate-300 mb-2">
            Suscríbete y llévate un ticket regalo.
          </p>
          
          <form id="newsletter-form-sidebar" class="w-full space-y-1.5">
            <input 
              type="email" 
              id="newsletter-email-sb"
              placeholder="Tu correo" 
              class="w-full px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-700 text-slate-100 text-[11px] focus:outline-none focus:border-blue-500 transition-colors"
              required
            />
            <button type="submit" id="newsletter-btn-sb" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-1.5 px-2 rounded-lg transition-all text-[11px] shadow-md cursor-pointer">
              Suscríbete
            </button>
          </form>
          <p id="newsletter-msg-sb" class="text-[10px] mt-1 hidden"></p>
        </div>

      </aside>

      <!-- VUE PRINCIPALE -->
      <main class="lg:col-span-9 w-full">
        <slot />
      </main>

    </div>
  </div>

  <footer class="border-t border-slate-800/80 glass-panel mt-auto py-3">
    <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
      © 2026 LuxeMotors - Tienda de Coches. Todos los derechos reservados.
    </div>
  </footer>

  {!user && <AuthModal />}

  <script>
    import { supabase } from '@/lib/supabase';

    const formSb = document.getElementById('newsletter-form-sidebar') as HTMLFormElement;
    const emailInputSb = document.getElementById('newsletter-email-sb') as HTMLInputElement;
    const msgElSb = document.getElementById('newsletter-msg-sb');
    const btnSb = document.getElementById('newsletter-btn-sb') as HTMLButtonElement;

    if (formSb) {
      formSb.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInputSb.value.trim();
        if (!email) return;

        if (btnSb) {
          btnSb.textContent = 'Enviando...';
          btnSb.setAttribute('disabled', 'true');
        }

        try {
          const { error } = await supabase.from('suscriptores').insert([{ email }]);
          if (error) {
            if (error.code === '23505') throw new Error('Ya registrado.');
            throw new Error('Error.');
          }
          if (msgElSb) {
            msgElSb.textContent = '¡Suscrito!';
            msgElSb.className = 'text-[10px] mt-1 text-emerald-400 font-medium';
            msgElSb.classList.remove('hidden');
          }
          formSb.reset();
        } catch (err: any) {
          if (msgElSb) {
            msgElSb.textContent = err.message || 'Error.';
            msgElSb.className = 'text-[10px] mt-1 text-red-400 font-medium';
            msgElSb.classList.remove('hidden');
          }
        } finally {
          if (btnSb) {
            btnSb.textContent = 'Suscríbete';
            btnSb.removeAttribute('disabled');
          }
        }
      });
    }
  </script>
</body>
</html>
