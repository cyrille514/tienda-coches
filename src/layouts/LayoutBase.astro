---
// src/layouts/LayoutBase.astro
import '../styles/global.css';
import MenuCategorias from '../components/MenuCategorias.astro';
import { supabase } from '../lib/supabase';

interface Props {
  title?: string;
  categoriaActivaId?: number;
}

const { title = "Tienda de Coches | Exclusive Motors", categoriaActivaId } = Astro.props;

// VÉRIFICATION SERVEUR : Récupération de la session utilisateur via les cookies
const accessToken = Astro.cookies.get('sb-access-token');
const refreshToken = Astro.cookies.get('sb-refresh-token');

let user = null;
if (accessToken && refreshToken) {
  const { data } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  if (data.user) {
    user = data.user;
  }
}
---

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased">

  <!-- HEADER D'EN-TÊTE PREMIUM -->
  <header class="sticky top-0 z-50 glass-panel border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- LOGO -->
      <a href="/productos?categoria=1" class="flex items-center gap-3 group">
        <div>
          <span class="text-xl font-extrabold tracking-tight text-white block leading-none">
            TIENDA<span class="gradient-text">COCHES</span>
          </span>
          <span class="text-[10px] tracking-widest text-white uppercase font-semibold">Showroom Automóvil</span>
        </div>
      </a>

      <!-- NAVIGATION DU HEADER -->
      <div class="flex items-center gap-4">
        
        {user ? (
          /* SI LE CLIENT EST CONNECTÉ : On affiche son email/nom et un lien direct vers /login */
          <a 
            href="/login"
            class="flex items-center gap-2 px-3 py-2 rounded-lg text-emerald-400 bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors text-sm font-medium"
          >
            <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="hidden sm:inline truncate max-w-[160px]">{user.email}</span>
          </a>
        ) : (
          /* S'IL N'EST PAS CONNECTÉ : Bouton classique qui ouvre la modale */
          <button 
            type="button" 
            id="user-icon-btn"
            class="flex items-center gap-2 px-3 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-colors text-sm font-medium cursor-pointer focus:outline-none"
          >
            <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="hidden sm:inline">Usuarios</span>
          </button>
        )}

        <!-- BOUTON PANIER / CARRITO -->
        <a href="/carrito" class="relative flex items-center gap-2.5 px-4 py-2 rounded-xl bg-blue-600/10 hover:bg-blue-600/20 text-blue-400 border border-blue-500/30 transition-all group">
          <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="font-semibold text-sm">Carito</span>
          <span 
            id="cart-badge" 
            class="bg-blue-600 text-white text-xs font-bold px-2 py-0.5 rounded-full min-w-[20px] text-center hidden"
          >
            0
          </span>
        </a>
      </div>

    </div>
  </header>

  <!-- CONTENU PRINCIPAL EN GRILLE (SIDEBAR + SLOT) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full flex-1">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- SIDEBAR GAUCHE -->
      <aside class="lg:col-span-3 space-y-6">
        
        <!-- Menu Categorias -->
        <div class="glass-panel p-5 rounded-2xl">
          <MenuCategorias categoriaActivaId={categoriaActivaId} />
        </div>

        <!-- Social Media Links -->
        <div class="glass-panel p-4 rounded-2xl text-xs text-green-500 flex justify-around">
          <a href="#" class="hover:text-blue-600 transition-colors">Instagram</a>
          <a href="#" class="hover:text-blue-600 transition-colors">LinkedIn</a>
          <a href="#" class="hover:text-blue-600 transition-colors">Facebook</a>
        </div>

        <!-- Info Contact & Localisation -->
        <div class="glass-panel p-5 rounded-2xl space-y-3">
          <div class="flex items-center gap-2 text-emerald-400 text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Dónde estamos
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">
            Visita nuestro showroom exclusivo en el número 114 de la calle Balmes, Barcelona.
          </p>
          <a href="mailto:hola@tiendacoches.com" class="text-xs font-semibold text-blue-400 hover:underline block pt-1">
            hola@tiendacoches.com
          </a>
        </div>

      </aside>

      <!-- COLONNE DROITE (CONTENU DYNAMIQUE DES PAGES) -->
      <main class="lg:col-span-9">
        <slot />
      </main>

    </div>
  </div>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800/80 glass-panel mt-auto py-6">
    <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
      © 2026 LuxeMotors - Tienda de Coches. Todos los derechos reservados.
    </div>
  </footer>

  <!-- MODALE POP-UP DE CONNEXION (2 COLONNES) - Uniquement affichée si non connecté -->
  {!user && (
    <dialog id="auth-modal" class="p-0 rounded-2xl shadow-2xl backdrop:bg-black/80 border border-slate-800 max-w-3xl w-full bg-slate-900 text-white overflow-hidden m-auto">
      <div class="relative flex flex-col md:flex-row w-full min-h-[460px]">
        
        <!-- Bouton de fermeture (X) -->
        <button id="close-modal-btn" type="button" class="absolute top-4 right-4 text-slate-400 hover:text-white text-xl font-bold z-20 cursor-pointer">
          ✕
        </button>

        <!-- COLONNE GAUCHE: Google OAuth -->
        <div class="w-full md:w-1/2 p-8 flex flex-col justify-between items-center border-b md:border-b-0 md:border-r border-slate-800 bg-slate-900">
          <div class="my-auto w-full text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-800 mb-4">
              <svg class="w-6 h-6" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-white mb-1">Iniciar sesión</h2>
            <p class="text-xs text-slate-400 mb-6">Utiliza tu cuenta de Google</p>

            <button 
              id="modal-google-btn"
              type="button"
              class="w-full flex items-center justify-center gap-3 bg-white hover:bg-slate-100 text-slate-800 font-semibold py-2.5 px-4 rounded-lg transition-colors shadow-md cursor-pointer text-sm"
            >
              Iniciar sesión con Google
            </button>
          </div>

          <div class="text-xs text-left w-full text-slate-400 mt-4">
            <span class="text-blue-400 font-semibold">Crear cuenta</span> (Primera vez)
          </div>
        </div>

        <!-- COLONNE DROITE: Formulaire de Création de Compte -->
        <div class="w-full md:w-1/2 p-8 bg-slate-800/40 flex flex-col justify-center">
          <h3 class="text-base font-semibold text-blue-400 mb-4 leading-snug">
            Formulario de registro con los datos del nuevo cliente.
          </h3>

          <form class="space-y-3">
            <div>
              <label class="block text-xs text-slate-400 mb-1">Nombre y Apellidos</label>
              <input type="text" required class="w-full bg-slate-950 border border-slate-700 rounded-md p-2 text-xs text-white focus:outline-none focus:border-blue-500" placeholder="Ej. Carlos Gómez" />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Correo electrónico o teléfono</label>
              <input type="email" required class="w-full bg-slate-950 border border-slate-700 rounded-md p-2 text-xs text-white focus:outline-none focus:border-blue-500" placeholder="correo@ejemplo.com" />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Contraseña</label>
              <input type="password" required class="w-full bg-slate-950 border border-slate-700 rounded-md p-2 text-xs text-white focus:outline-none focus:border-blue-500" placeholder="••••••••" />
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-lg transition-colors mt-2 text-xs cursor-pointer">
              Siguiente
            </button>
          </form>
        </div>

      </div>
    </dialog>
  )}

  <!-- SCRIPTS CLIENTS -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Synchronisation du compteur du panier
      const cart = JSON.parse(localStorage.getItem('tienda_coches_carrito') || '[]');
      const totalItems = cart.reduce((sum, item) => sum + item.cantidad, 0);
      const badge = document.getElementById('cart-badge');
      if (badge && totalItems > 0) {
        badge.textContent = totalItems;
        badge.classList.remove('hidden');
      }
    });
  </script>

  <script>
    import { supabase } from '../lib/supabase';

    const modal = document.getElementById('auth-modal') as HTMLDialogElement;
    const userBtn = document.getElementById('user-icon-btn');
    const closeBtn = document.getElementById('close-modal-btn');
    const googleBtn = document.getElementById('modal-google-btn');

    // Ouverture de la modale
    userBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      modal?.showModal();
    });

    // Fermeture via la croix
    closeBtn?.addEventListener('click', () => {
      modal?.close();
    });

    // Fermeture lors d'un clic sur l'arrière-plan
    modal?.addEventListener('click', (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        modal.close();
      }
    });

    // Action Google OAuth
    googleBtn?.addEventListener('click', async () => {
      await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: `${window.location.origin}/login`,
          queryParams: {
            prompt: 'select_account',
          },
        },
      });
    });
  </script>

</body>
</html>